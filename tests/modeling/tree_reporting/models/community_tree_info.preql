import tree_common;

# One property per city, not one shared scalar. This feeds every city's
# `{code}_published_data_updated_through`, so a single shared timestamp would make
# one approval anywhere mark all fourteen city Parquets stale and re-materialize
# every one — a full re-download of every municipal dataset to publish one tree.
#
# Per-city *columns* rather than a `city`-grained property with a filtered
# datasource: Trilogy pushes a `complete where` clause into row queries but not
# into the watermark probe, which stays `SELECT MAX(col) FROM uv_run(...)` over
# every row. Verified — with a row-per-city layout a Boston-only approval moved
# San Francisco's watermark too.
property <*>.ussfo_community_data_updated_through datetime; # when approved community submissions for USSFO are through
property <*>.usnyc_community_data_updated_through datetime; # when approved community submissions for USNYC are through
property <*>.usbos_community_data_updated_through datetime; # when approved community submissions for USBOS are through
property <*>.frpar_community_data_updated_through datetime; # when approved community submissions for FRPAR are through
property <*>.usbtv_community_data_updated_through datetime; # when approved community submissions for USBTV are through
property <*>.cavan_community_data_updated_through datetime; # when approved community submissions for CAVAN are through
property <*>.deber_community_data_updated_through datetime; # when approved community submissions for DEBER are through
property <*>.nlams_community_data_updated_through datetime; # when approved community submissions for NLAMS are through
property <*>.gblon_community_data_updated_through datetime; # when approved community submissions for GBLON are through
property <*>.aumel_community_data_updated_through datetime; # when approved community submissions for AUMEL are through
