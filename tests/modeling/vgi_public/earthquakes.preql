key event_id string;
property event_id.event_time datetime;
property event_id.magnitude float;
property event_id.magnitude_type string;
property event_id.place string;
property event_id.depth_km float;
property event_id.latitude float;
property event_id.longitude float;
property event_id.tsunami bool;
property event_id.significance int;
property event_id.network string;

datasource recent_quakes (
    event_id,
    time: event_time,
    mag: ?magnitude,
    magtype: ?magnitude_type,
    ?place,
    depth: depth_km,
    latitude,
    longitude,
    tsunami,
    sig: significance,
    net: network,
)
grain (event_id)
address earthquakes.main.recent;
