import earthquakes as quake;
import trains as trains;
import weather as weather;
import places as places;

where weather.latitude = 52.374 and weather.longitude = 4.890
select
    count(quake.event_id) as quakes,
    count(trains.station_code) as stations,
    max(weather.temp_max) as amsterdam_week_high,
    count(places.place_id) as amsterdam_places;
