generated_sql = """

WITH 
abundant as (
SELECT
    \"part_part\".\"p_partkey\" as \"part_id\",
    \"part_partsupp\".\"ps_availqty\" as \"part_available_quantity\",
    \"part_partsupp\".\"ps_suppkey\" as \"part_supplier_id\",
    \"part_supplier_supplier\".\"s_address\" as \"part_supplier_address\",
    \"part_supplier_supplier\".\"s_name\" as \"part_supplier_name\"
FROM
    \"memory\".\"partsupp\" as \"part_partsupp\"
    INNER JOIN \"memory\".\"part\" as \"part_part\" on \"part_partsupp\".\"ps_partkey\" = \"part_part\".\"p_partkey\"
    INNER JOIN \"memory\".\"supplier\" as \"part_supplier_supplier\" on \"part_partsupp\".\"ps_suppkey\" = \"part_supplier_supplier\".\"s_suppkey\"
    INNER JOIN \"memory\".\"nation\" as \"part_supplier_nation_nation\" on \"part_supplier_supplier\".\"s_nationkey\" = \"part_supplier_nation_nation\".\"n_nationkey\"
WHERE
    \"part_part\".\"p_name\" like 'forest%' and UPPER(\"part_supplier_nation_nation\".\"n_name\")  = 'CANADA'
),
cheerful as (
SELECT
    \"lineitem\".\"l_partkey\" as \"part_id\",
    \"lineitem\".\"l_suppkey\" as \"part_supplier_id\",
    sum(\"lineitem\".\"l_quantity\") as \"qty_per_partsupp_1994\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\"
    INNER JOIN \"memory\".\"supplier\" as \"part_supplier_supplier\" on \"lineitem\".\"l_suppkey\" = \"part_supplier_supplier\".\"s_suppkey\"
    INNER JOIN \"memory\".\"nation\" as \"part_supplier_nation_nation\" on \"part_supplier_supplier\".\"s_nationkey\" = \"part_supplier_nation_nation\".\"n_nationkey\"
WHERE
    \"lineitem\".\"l_shipdate\" >= date '1994-01-01' and \"lineitem\".\"l_shipdate\" < date '1995-01-01' and UPPER(\"part_supplier_nation_nation\".\"n_name\")  = 'CANADA'

GROUP BY
    1,
    2)
SELECT
    \"abundant\".\"part_supplier_name\" as \"part_supplier_name\",
    \"abundant\".\"part_supplier_address\" as \"part_supplier_address\"
FROM
    \"abundant\"
    INNER JOIN \"cheerful\" on \"abundant\".\"part_id\" = \"cheerful\".\"part_id\" AND \"abundant\".\"part_supplier_id\" = \"cheerful\".\"part_supplier_id\"
WHERE
    \"abundant\".\"part_available_quantity\" > 0.5 * \"cheerful\".\"qty_per_partsupp_1994\"

GROUP BY
    1,
    2
ORDER BY 
    \"abundant\".\"part_supplier_name\" asc"""
