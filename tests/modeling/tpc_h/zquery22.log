generated_sql = """

WITH 
thoughtful as (
SELECT
    \"orders_customer_customers\".\"c_acctbal\" as \"orders_customer_account_balance\",
    \"orders_customer_customers\".\"c_custkey\" as \"orders_customer_id\",
    \"orders_customer_customers\".\"c_phone\" as \"orders_customer_phone\",
    \"orders_orders\".\"o_orderkey\" as \"orders_id\",
    SUBSTRING(\"orders_customer_customers\".\"c_phone\",1,2) as \"cntrycode\"
FROM
    \"memory\".\"customer\" as \"orders_customer_customers\"
    LEFT OUTER JOIN \"memory\".\"orders\" as \"orders_orders\" on \"orders_customer_customers\".\"c_custkey\" = \"orders_orders\".\"o_custkey\"
WHERE
    (SUBSTRING(\"orders_customer_customers\".\"c_phone\",1,2) is not null and SUBSTRING(\"orders_customer_customers\".\"c_phone\",1,2) in ('13','31','23','29','30','18','17')) and \"orders_orders\".\"o_orderkey\" is null
),
highfalutin as (
SELECT
    avg(\"orders_customer_customers\".\"c_acctbal\") as \"avg_bal_in_target\"
FROM
    \"memory\".\"customer\" as \"orders_customer_customers\"
WHERE
    \"orders_customer_customers\".\"c_acctbal\" > 0 and (SUBSTRING(\"orders_customer_customers\".\"c_phone\",1,2) is not null and SUBSTRING(\"orders_customer_customers\".\"c_phone\",1,2) in ('13','31','23','29','30','18','17'))
)
SELECT
    \"thoughtful\".\"cntrycode\" as \"cntrycode\",
    count(\"thoughtful\".\"orders_customer_id\") as \"numcust\",
    sum(\"thoughtful\".\"orders_customer_account_balance\") as \"totacctbal\"
FROM
    \"thoughtful\"
    INNER JOIN \"highfalutin\" on 1=1
WHERE
    \"thoughtful\".\"orders_customer_account_balance\" > \"highfalutin\".\"avg_bal_in_target\" and (SUBSTRING(\"thoughtful\".\"orders_customer_phone\",1,2) is not null and SUBSTRING(\"thoughtful\".\"orders_customer_phone\",1,2) in ('13','31','23','29','30','18','17')) and \"thoughtful\".\"orders_id\" is null

GROUP BY
    1
ORDER BY 
    \"thoughtful\".\"cntrycode\" asc"""
