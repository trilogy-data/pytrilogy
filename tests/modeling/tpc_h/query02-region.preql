import part;

# Guards the shape where a WHERE atom is ALSO the condition of a filtered
# aggregate keyed by something else (here: min-by-part vs a region predicate).
# The atom used to be placed inside the aggregate's filter scope and dropped
# from the outer plan entirely. Spec q02's `supply_cost = min(...)` makes the
# drop invisible in dbgen data at any scale factor; the tolerance below admits
# many suppliers per part, so a dropped region filter shows up immediately.

auto min_supply_cost_in_europe <- min(supply_cost ? supplier.nation.region.name = 'EUROPE') by id;

where
    size = 15
    and type like '%BRASS'
    and supplier.nation.region.name = 'EUROPE'
    and supply_cost <= min_supply_cost_in_europe * 1.5
select
    id,
    supplier.name,
    supplier.nation.name,
    supply_cost
order by
    id asc,
    supplier.name asc
limit 100;
