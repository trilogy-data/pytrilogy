generated_sql = """

WITH 
thoughtful as (
SELECT
    \"lineitem\".\"l_orderkey\" as \"order_id\",
    sum(\"lineitem\".\"l_quantity\") as \"qty_per_order\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\"
GROUP BY
    1
HAVING
    sum(\"lineitem\".\"l_quantity\") > 300
),
wakeful as (
SELECT
    \"order_customer_customers\".\"c_custkey\" as \"order_customer_id\",
    \"order_customer_customers\".\"c_name\" as \"order_customer_name\",
    \"order_orders\".\"o_orderdate\" as \"order_date\",
    \"order_orders\".\"o_orderkey\" as \"order_id\",
    \"order_orders\".\"o_totalprice\" as \"order_total_price\"
FROM
    \"memory\".\"orders\" as \"order_orders\"
    INNER JOIN \"memory\".\"customer\" as \"order_customer_customers\" on \"order_orders\".\"o_custkey\" = \"order_customer_customers\".\"c_custkey\")
SELECT
    \"wakeful\".\"order_customer_name\" as \"order_customer_name\",
    \"wakeful\".\"order_customer_id\" as \"order_customer_id\",
    \"wakeful\".\"order_id\" as \"order_id\",
    \"wakeful\".\"order_date\" as \"order_date\",
    \"wakeful\".\"order_total_price\" as \"order_total_price\",
    \"thoughtful\".\"qty_per_order\" as \"qty_per_order\"
FROM
    \"wakeful\"
    INNER JOIN \"thoughtful\" on \"wakeful\".\"order_id\" = \"thoughtful\".\"order_id\"
ORDER BY 
    \"wakeful\".\"order_total_price\" desc,
    \"wakeful\".\"order_date\" asc
LIMIT (100)"""
