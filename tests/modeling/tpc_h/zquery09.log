generated_sql = """

WITH 
quizzical as (
SELECT
    \"lineitem\".\"l_discount\" as \"discount\",
    \"lineitem\".\"l_extendedprice\" as \"extended_price\",
    \"lineitem\".\"l_orderkey\" as \"order_id\",
    \"lineitem\".\"l_partkey\" as \"part_id\",
    \"lineitem\".\"l_quantity\" as \"quantity\",
    \"lineitem\".\"l_suppkey\" as \"part_supplier_id\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\")
SELECT
    UPPER(\"part_supplier_nation_nation\".\"n_name\")  as \"nation\",
    year(\"order_orders\".\"o_orderdate\") as \"o_year\",
    sum(( \"quizzical\".\"extended_price\" * (1 - \"quizzical\".\"discount\") ) - ( \"part_partsupp\".\"ps_supplycost\" * \"quizzical\".\"quantity\" )) as \"sum_profit\"
FROM
    \"quizzical\"
    INNER JOIN \"memory\".\"orders\" as \"order_orders\" on \"quizzical\".\"order_id\" = \"order_orders\".\"o_orderkey\"
    INNER JOIN \"memory\".\"partsupp\" as \"part_partsupp\" on \"quizzical\".\"part_id\" = \"part_partsupp\".\"ps_partkey\" AND \"quizzical\".\"part_supplier_id\" = \"part_partsupp\".\"ps_suppkey\"
    INNER JOIN \"memory\".\"part\" as \"part_part\" on \"part_partsupp\".\"ps_partkey\" = \"part_part\".\"p_partkey\"
    LEFT OUTER JOIN \"memory\".\"supplier\" as \"part_supplier_supplier\" on \"part_partsupp\".\"ps_suppkey\" = \"part_supplier_supplier\".\"s_suppkey\"
    LEFT OUTER JOIN \"memory\".\"nation\" as \"part_supplier_nation_nation\" on \"part_supplier_supplier\".\"s_nationkey\" = \"part_supplier_nation_nation\".\"n_nationkey\"
WHERE
    \"part_part\".\"p_name\" like '%green%'

GROUP BY
    1,
    2
ORDER BY 
    \"nation\" asc,
    \"o_year\" desc"""
