generated_sql = """

WITH 
quizzical as (
SELECT
    \"lineitem\".\"l_extendedprice\" as \"extended_price\",
    \"lineitem\".\"l_partkey\" as \"part_id\",
    \"lineitem\".\"l_quantity\" as \"quantity\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\"),
wakeful as (
SELECT
    \"part_part\".\"p_partkey\" as \"part_id\",
    \"quizzical\".\"extended_price\" as \"extended_price\",
    \"quizzical\".\"quantity\" as \"quantity\"
FROM
    \"memory\".\"part\" as \"part_part\"
    INNER JOIN \"quizzical\" on \"part_part\".\"p_partkey\" = \"quizzical\".\"part_id\"
WHERE
    \"part_part\".\"p_brand\" = 'Brand#23' and \"part_part\".\"p_container\" = 'MED BOX'
),
cheerful as (
SELECT
    \"wakeful\".\"part_id\" as \"part_id\",
    avg(\"wakeful\".\"quantity\") as \"avg_qty_per_part\"
FROM
    \"wakeful\"
GROUP BY
    1)
SELECT
    sum(\"wakeful\".\"extended_price\") / 7.0 as \"avg_yearly\"
FROM
    \"wakeful\"
    INNER JOIN \"cheerful\" on \"wakeful\".\"part_id\" = \"cheerful\".\"part_id\"
WHERE
    \"wakeful\".\"quantity\" < 0.2 * \"cheerful\".\"avg_qty_per_part\"
"""
