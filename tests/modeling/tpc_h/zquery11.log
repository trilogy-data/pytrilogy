generated_sql = """

WITH 
cheerful as (
SELECT
    \"partsupp\".\"ps_partkey\" as \"germany_partsupp_part_id\",
    \"partsupp\".\"ps_supplycost\" * \"partsupp\".\"ps_availqty\" as \"germany_partsupp_supply_value\"
FROM
    \"memory\".\"partsupp\" as \"partsupp\"
    INNER JOIN \"memory\".\"supplier\" as \"supplier_supplier\" on \"partsupp\".\"ps_suppkey\" = \"supplier_supplier\".\"s_suppkey\"
    INNER JOIN \"memory\".\"nation\" as \"supplier_nation_nation\" on \"supplier_supplier\".\"s_nationkey\" = \"supplier_nation_nation\".\"n_nationkey\"
WHERE
    UPPER(\"supplier_nation_nation\".\"n_name\")  = 'GERMANY'
),
abundant as (
SELECT
    \"cheerful\".\"germany_partsupp_part_id\" as \"part_values_germany_partsupp_part_id\",
    sum(\"cheerful\".\"germany_partsupp_supply_value\") as \"part_values_total_value\"
FROM
    \"cheerful\"
GROUP BY
    1),
questionable as (
SELECT
    sum(\"cheerful\".\"germany_partsupp_supply_value\") as \"germany_total_value\"
FROM
    \"cheerful\")
SELECT
    \"abundant\".\"part_values_germany_partsupp_part_id\" as \"part_values_germany_partsupp_part_id\",
    \"abundant\".\"part_values_total_value\" as \"part_values_total_value\"
FROM
    \"questionable\"
    INNER JOIN \"abundant\" on 1=1
WHERE
    \"abundant\".\"part_values_total_value\" > \"questionable\".\"germany_total_value\" * 0.0001

ORDER BY 
    \"abundant\".\"part_values_total_value\" desc"""
