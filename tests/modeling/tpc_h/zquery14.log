generated_sql = """

WITH 
quizzical as (
SELECT
    \"lineitem\".\"l_discount\" as \"discount\",
    \"lineitem\".\"l_extendedprice\" as \"extended_price\",
    \"lineitem\".\"l_partkey\" as \"part_id\",
    \"lineitem\".\"l_shipdate\" as \"ship_date\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\"
WHERE
    \"lineitem\".\"l_shipdate\" >= date '1995-09-01' and \"lineitem\".\"l_shipdate\" < date '1995-10-01'
)
SELECT
    ( 100.0 * sum(CASE WHEN \"part_part\".\"p_type\" like 'PROMO%' THEN \"quizzical\".\"extended_price\" * (1 - \"quizzical\".\"discount\") ELSE NULL END) ) / sum(\"quizzical\".\"extended_price\" * (1 - \"quizzical\".\"discount\")) as \"promo_revenue\"
FROM
    \"memory\".\"part\" as \"part_part\"
    INNER JOIN \"quizzical\" on \"part_part\".\"p_partkey\" = \"quizzical\".\"part_id\"
WHERE
    \"quizzical\".\"ship_date\" >= date '1995-09-01' and \"quizzical\".\"ship_date\" < date '1995-10-01'
"""
