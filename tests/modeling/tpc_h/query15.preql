import lineitem;
auto supplier_rev <- sum(revenue) by part.supplier.id;
auto max_supplier_rev <- max(supplier_rev) by *;
where
    ship_date >= '1996-01-01'::date and ship_date < '1996-04-01'::date
select
    part.supplier.id,
    part.supplier.name,
    part.supplier.address,
    part.supplier.phone,
    supplier_rev as total_revenue,
having
    total_revenue = max_supplier_rev

order by
    part.supplier.id asc
;
