generated_sql = """

WITH 
quizzical as (
SELECT
    \"lineitem\".\"l_discount\" as \"discount\",
    \"lineitem\".\"l_extendedprice\" as \"extended_price\",
    \"lineitem\".\"l_partkey\" as \"part_id\",
    \"lineitem\".\"l_quantity\" as \"quantity\",
    \"lineitem\".\"l_shipinstruct\" as \"ship_instruct\",
    \"lineitem\".\"l_shipmode\" as \"ship_mode\"
FROM
    \"memory\".\"lineitem\" as \"lineitem\")
SELECT
    sum(\"quizzical\".\"extended_price\" * (1 - \"quizzical\".\"discount\")) as \"q_revenue\"
FROM
    \"memory\".\"part\" as \"part_part\"
    INNER JOIN \"quizzical\" on \"part_part\".\"p_partkey\" = \"quizzical\".\"part_id\"
WHERE
    ( ( \"part_part\".\"p_brand\" = 'Brand#12' and (\"part_part\".\"p_container\" is not null and \"part_part\".\"p_container\" in ('SM CASE','SM BOX','SM PACK','SM PKG')) and \"quizzical\".\"quantity\" >= 1 and \"quizzical\".\"quantity\" <= 11 and \"part_part\".\"p_size\" BETWEEN 1 AND 5 and (\"quizzical\".\"ship_mode\" is not null and \"quizzical\".\"ship_mode\" in ('AIR','AIR REG')) and \"quizzical\".\"ship_instruct\" = 'DELIVER IN PERSON' ) or ( \"part_part\".\"p_brand\" = 'Brand#23' and (\"part_part\".\"p_container\" is not null and \"part_part\".\"p_container\" in ('MED BAG','MED BOX','MED PKG','MED PACK')) and \"quizzical\".\"quantity\" >= 10 and \"quizzical\".\"quantity\" <= 20 and \"part_part\".\"p_size\" BETWEEN 1 AND 10 and (\"quizzical\".\"ship_mode\" is not null and \"quizzical\".\"ship_mode\" in ('AIR','AIR REG')) and \"quizzical\".\"ship_instruct\" = 'DELIVER IN PERSON' ) or ( \"part_part\".\"p_brand\" = 'Brand#34' and (\"part_part\".\"p_container\" is not null and \"part_part\".\"p_container\" in ('LG CASE','LG BOX','LG PACK','LG PKG')) and \"quizzical\".\"quantity\" >= 20 and \"quizzical\".\"quantity\" <= 30 and \"part_part\".\"p_size\" BETWEEN 1 AND 15 and (\"quizzical\".\"ship_mode\" is not null and \"quizzical\".\"ship_mode\" in ('AIR','AIR REG')) and \"quizzical\".\"ship_instruct\" = 'DELIVER IN PERSON' ) )
"""
