generated_sql = """

WITH 
quizzical as (
SELECT
    \"order_items\".\"product_id\" as \"product_id\",
    sum(\"order_items\".\"sale_price\") as \"revenue\"
FROM
    \"order_items\"
GROUP BY
    1)
SELECT
    \"product_products\".\"id\" as \"product_id\",
    \"product_products\".\"brand\" as \"product_brand\",
    \"quizzical\".\"revenue\" as \"revenue\"
FROM
    \"products\" as \"product_products\"
    LEFT OUTER JOIN \"quizzical\" on \"product_products\".\"id\" = \"quizzical\".\"product_id\"
ORDER BY 
    \"product_products\".\"id\" asc"""
