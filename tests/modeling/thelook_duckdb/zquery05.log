generated_sql = """
SELECT
    \"user_users\".\"traffic_source\" as \"user_traffic_source\",
    \"product_products\".\"department\" as \"product_department\",
    sum(\"order_items\".\"sale_price\") as \"revenue\"
FROM
    \"users\" as \"user_users\"
    INNER JOIN \"order_items\" as \"order_items\" on \"user_users\".\"id\" = \"order_items\".\"user_id\"
    INNER JOIN \"products\" as \"product_products\" on \"order_items\".\"product_id\" = \"product_products\".\"id\"
WHERE
    \"order_items\".\"user_id\" is not null and \"order_items\".\"product_id\" is not null

GROUP BY
    1,
    2
ORDER BY 
    \"user_users\".\"traffic_source\" asc,
    \"product_products\".\"department\" asc"""
