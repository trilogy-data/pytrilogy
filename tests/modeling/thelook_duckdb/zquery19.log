generated_sql = """

WITH 
uneven as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"order_id\" as \"order_id\",
    coalesce(\"order_items\".\"product_id\",\"product_products\".\"id\") as \"product_id\",
    coalesce(\"order_items\".\"user_id\",\"user_users\".\"id\") as \"user_id\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"order_items\" as \"order_items\" on \"user_users\".\"id\" = \"order_items\".\"user_id\"
    FULL JOIN \"products\" as \"product_products\" on \"order_items\".\"product_id\" = \"product_products\".\"id\"),
thoughtful as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"order_id\" as \"order_id\",
    \"order_items\".\"sale_price\" as \"sale_price\",
    \"product_products\".\"cost\" as \"product_cost\"
FROM
    \"products\" as \"product_products\"
    INNER JOIN \"order_items\" as \"order_items\" on \"product_products\".\"id\" = \"order_items\".\"product_id\"),
highfalutin as (
SELECT
    \"order_items\".\"order_id\" as \"order_id\",
    sum(\"order_items\".\"sale_price\") as \"order_line_revenue\"
FROM
    \"order_items\"
GROUP BY
    1),
cooperative as (
SELECT
    \"highfalutin\".\"order_line_revenue\" as \"order_line_revenue\",
    \"thoughtful\".\"id\" as \"id\",
    \"thoughtful\".\"sale_price\" - \"thoughtful\".\"product_cost\" as \"item_margin\",
    \"thoughtful\".\"sale_price\" as \"sale_price\"
FROM
    \"thoughtful\"
    LEFT OUTER JOIN \"highfalutin\" on \"thoughtful\".\"order_id\" = \"highfalutin\".\"order_id\"),
questionable as (
SELECT
    \"cooperative\".\"id\" as \"id\",
    \"cooperative\".\"item_margin\" as \"margin\",
    \"cooperative\".\"order_line_revenue\" as \"total_order_revenue\",
    \"cooperative\".\"sale_price\" as \"revenue\"
FROM
    \"cooperative\")
SELECT
    \"uneven\".\"order_id\" as \"order_id\",
    \"uneven\".\"id\" as \"id\",
    \"uneven\".\"user_id\" as \"user_id\",
    \"uneven\".\"product_id\" as \"product_id\",
    \"questionable\".\"revenue\" as \"revenue\",
    \"questionable\".\"margin\" as \"margin\",
    \"questionable\".\"total_order_revenue\" as \"total_order_revenue\"
FROM
    \"uneven\"
    LEFT OUTER JOIN \"questionable\" on \"uneven\".\"id\" = \"questionable\".\"id\"
ORDER BY 
    \"uneven\".\"order_id\" asc nulls first,
    \"uneven\".\"id\" asc nulls first,
    \"uneven\".\"user_id\" asc nulls first,
    \"uneven\".\"product_id\" asc nulls first"""
