generated_sql = """

WITH 
wakeful as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"order_id\" as \"order_id\",
    \"order_items\".\"sale_price\" - \"product_products\".\"cost\" as \"margin\",
    \"order_items\".\"sale_price\" as \"revenue\",
    \"order_items\".\"user_id\" as \"user_id\",
    \"product_products\".\"id\" as \"product_id\"
FROM
    \"products\" as \"product_products\"
    INNER JOIN \"order_items\" as \"order_items\" on \"product_products\".\"id\" = \"order_items\".\"product_id\"),
thoughtful as (
SELECT
    \"wakeful\".\"order_id\" as \"order_id\",
    sum(\"wakeful\".\"revenue\") as \"total_order_revenue\"
FROM
    \"wakeful\"
GROUP BY
    1)
SELECT
    \"wakeful\".\"order_id\" as \"order_id\",
    \"wakeful\".\"id\" as \"id\",
    coalesce(\"user_users\".\"id\",\"wakeful\".\"user_id\") as \"user_id\",
    coalesce(\"product_products\".\"id\",\"wakeful\".\"product_id\") as \"product_id\",
    \"wakeful\".\"revenue\" as \"revenue\",
    \"wakeful\".\"margin\" as \"margin\",
    \"thoughtful\".\"total_order_revenue\" as \"total_order_revenue\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"wakeful\" on \"user_users\".\"id\" = \"wakeful\".\"user_id\"
    FULL JOIN \"products\" as \"product_products\" on \"wakeful\".\"product_id\" = \"product_products\".\"id\"
    LEFT OUTER JOIN \"thoughtful\" on \"wakeful\".\"order_id\" = \"thoughtful\".\"order_id\"
ORDER BY 
    \"wakeful\".\"order_id\" asc nulls first,
    \"wakeful\".\"id\" asc nulls first,
    coalesce(\"user_users\".\"id\",\"wakeful\".\"user_id\") asc nulls first,
    coalesce(\"product_products\".\"id\",\"wakeful\".\"product_id\") asc nulls first"""
