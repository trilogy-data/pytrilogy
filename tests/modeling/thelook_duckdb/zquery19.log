generated_sql = """

WITH 
uneven as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"order_id\" as \"order_id\",
    coalesce(\"order_items\".\"product_id\",\"product_products\".\"id\") as \"product_id\",
    coalesce(\"order_items\".\"user_id\",\"user_users\".\"id\") as \"user_id\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"order_items\" as \"order_items\" on \"user_users\".\"id\" = \"order_items\".\"user_id\"
    FULL JOIN \"products\" as \"product_products\" on \"order_items\".\"product_id\" = \"product_products\".\"id\"),
wakeful as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"sale_price\" - \"product_products\".\"cost\" as \"item_margin\",
    \"order_items\".\"sale_price\" as \"sale_price\"
FROM
    \"products\" as \"product_products\"
    INNER JOIN \"order_items\" as \"order_items\" on \"product_products\".\"id\" = \"order_items\".\"product_id\"),
thoughtful as (
SELECT
    \"wakeful\".\"id\" as \"id\",
    \"wakeful\".\"item_margin\" as \"margin\",
    \"wakeful\".\"sale_price\" as \"revenue\"
FROM
    \"wakeful\"),
cooperative as (
SELECT
    \"order_items\".\"order_id\" as \"order_id\",
    sum(\"thoughtful\".\"revenue\") as \"total_order_revenue\"
FROM
    \"thoughtful\"
    INNER JOIN \"order_items\" as \"order_items\" on \"thoughtful\".\"id\" = \"order_items\".\"id\"
GROUP BY
    1)
SELECT
    \"uneven\".\"order_id\" as \"order_id\",
    \"uneven\".\"id\" as \"id\",
    \"uneven\".\"user_id\" as \"user_id\",
    \"uneven\".\"product_id\" as \"product_id\",
    \"thoughtful\".\"revenue\" as \"revenue\",
    \"thoughtful\".\"margin\" as \"margin\",
    \"cooperative\".\"total_order_revenue\" as \"total_order_revenue\"
FROM
    \"uneven\"
    LEFT OUTER JOIN \"thoughtful\" on \"uneven\".\"id\" = \"thoughtful\".\"id\"
    LEFT OUTER JOIN \"cooperative\" on \"uneven\".\"order_id\" = \"cooperative\".\"order_id\"
ORDER BY 
    \"uneven\".\"order_id\" asc nulls first,
    \"uneven\".\"id\" asc nulls first,
    \"uneven\".\"user_id\" asc nulls first,
    \"uneven\".\"product_id\" asc nulls first"""
