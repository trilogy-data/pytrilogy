generated_sql = """

WITH 
wakeful as (
SELECT
    \"order_items\".\"id\" as \"id\",
    \"order_items\".\"order_id\" as \"order_id\",
    \"order_items\".\"sale_price\" - \"product_products\".\"cost\" as \"item_margin\",
    \"order_items\".\"sale_price\" as \"sale_price\",
    \"order_items\".\"user_id\" as \"user_id\",
    \"product_products\".\"id\" as \"product_id\"
FROM
    \"products\" as \"product_products\"
    INNER JOIN \"order_items\" as \"order_items\" on \"product_products\".\"id\" = \"order_items\".\"product_id\"),
cheerful as (
SELECT
    \"wakeful\".\"id\" as \"id\",
    \"wakeful\".\"item_margin\" as \"margin\",
    \"wakeful\".\"order_id\" as \"order_id\",
    \"wakeful\".\"product_id\" as \"product_id\",
    \"wakeful\".\"sale_price\" as \"revenue\",
    \"wakeful\".\"user_id\" as \"user_id\"
FROM
    \"wakeful\"),
thoughtful as (
SELECT
    \"cheerful\".\"order_id\" as \"order_id\",
    sum(\"cheerful\".\"revenue\") as \"total_order_revenue\"
FROM
    \"cheerful\"
GROUP BY
    1)
SELECT
    \"cheerful\".\"order_id\" as \"order_id\",
    \"cheerful\".\"id\" as \"id\",
    coalesce(\"cheerful\".\"user_id\",\"user_users\".\"id\") as \"user_id\",
    coalesce(\"cheerful\".\"product_id\",\"product_products\".\"id\") as \"product_id\",
    \"cheerful\".\"revenue\" as \"revenue\",
    \"cheerful\".\"margin\" as \"margin\",
    \"thoughtful\".\"total_order_revenue\" as \"total_order_revenue\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"cheerful\" on \"user_users\".\"id\" = \"cheerful\".\"user_id\"
    LEFT OUTER JOIN \"thoughtful\" on \"cheerful\".\"order_id\" = \"thoughtful\".\"order_id\"
    FULL JOIN \"products\" as \"product_products\" on \"cheerful\".\"product_id\" = \"product_products\".\"id\"
ORDER BY 
    \"cheerful\".\"order_id\" asc nulls first,
    \"cheerful\".\"id\" asc nulls first,
    coalesce(\"cheerful\".\"user_id\",\"user_users\".\"id\") asc nulls first,
    coalesce(\"cheerful\".\"product_id\",\"product_products\".\"id\") asc nulls first"""
