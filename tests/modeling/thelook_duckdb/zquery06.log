generated_sql = """

WITH 
quizzical as (
SELECT
    \"order_items\".\"user_id\" as \"user_id\",
    sum(\"order_items\".\"sale_price\") as \"revenue\"
FROM
    \"order_items\"
GROUP BY
    1)
SELECT
    \"user_users\".\"id\" as \"user_id\",
    \"user_users\".\"state\" as \"user_state\",
    \"quizzical\".\"revenue\" as \"revenue\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"quizzical\" on \"user_users\".\"id\" = \"quizzical\".\"user_id\"
ORDER BY 
    \"user_users\".\"id\" asc"""
