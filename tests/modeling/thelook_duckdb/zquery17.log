generated_sql = """
SELECT
    \"user_users\".\"id\" as \"user_id\",
    \"product_products\".\"id\" as \"product_id\",
    \"user_users\".\"state\" as \"user_state\",
    \"product_products\".\"brand\" as \"product_brand\",
    \"user_product_sales\".\"revenue\" as \"revenue\",
    \"user_product_sales\".\"sale_line_count\" as \"sale_line_count\"
FROM
    \"user_product_sales\"
    INNER JOIN \"users\" as \"user_users\" on \"user_product_sales\".\"user_id\" = \"user_users\".\"id\"
    INNER JOIN \"products\" as \"product_products\" on \"user_product_sales\".\"product_id\" = \"product_products\".\"id\"
ORDER BY 
    \"user_users\".\"id\" asc,
    \"product_products\".\"id\" asc"""
