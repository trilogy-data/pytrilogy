generated_sql = """

WITH 
quizzical as (
SELECT
    \"order_items\".\"product_id\" as \"product_id\",
    \"order_items\".\"user_id\" as \"user_id\"
FROM
    \"order_items\"
GROUP BY
    1,
    2)
SELECT
    \"user_users\".\"traffic_source\" as \"user_traffic_source\",
    \"product_products\".\"category\" as \"product_category\"
FROM
    \"quizzical\"
    INNER JOIN \"users\" as \"user_users\" on \"quizzical\".\"user_id\" = \"user_users\".\"id\"
    INNER JOIN \"products\" as \"product_products\" on \"quizzical\".\"product_id\" = \"product_products\".\"id\"
GROUP BY
    1,
    2
ORDER BY 
    \"user_users\".\"traffic_source\" asc,
    \"product_products\".\"category\" asc"""
