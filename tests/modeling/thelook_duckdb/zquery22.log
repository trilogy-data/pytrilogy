generated_sql = """

WITH 
cheerful as (
SELECT
    \"order_items\".\"user_id\" as \"user_id\",
    \"order_orders\".\"status\" as \"order_status\",
    sum(\"order_items\".\"sale_price\" - \"product_products\".\"cost\") as \"margin\",
    sum(\"order_items\".\"sale_price\") as \"revenue\"
FROM
    \"order_items\"
    INNER JOIN \"orders\" as \"order_orders\" on \"order_items\".\"order_id\" = \"order_orders\".\"order_id\"
    INNER JOIN \"products\" as \"product_products\" on \"order_items\".\"product_id\" = \"product_products\".\"id\"
GROUP BY
    1,
    2)
SELECT
    \"cheerful\".\"order_status\" as \"order_status\",
    \"user_users\".\"id\" as \"user_id\",
    \"cheerful\".\"revenue\" as \"revenue\",
    \"cheerful\".\"margin\" as \"margin\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"cheerful\" on \"user_users\".\"id\" = \"cheerful\".\"user_id\"
ORDER BY 
    \"cheerful\".\"order_status\" asc nulls first,
    \"user_users\".\"id\" asc nulls first"""
