generated_sql = """

WITH 
highfalutin as (
SELECT
    \"user_product_sales\".\"user_id\" as \"user_id\",
    sum(\"user_product_sales\".\"revenue\") as \"revenue\"
FROM
    \"user_product_sales\"
GROUP BY
    1)
SELECT
    coalesce(\"highfalutin\".\"user_id\",\"user_users\".\"id\") as \"user_id\",
    \"user_users\".\"state\" as \"user_state\",
    \"highfalutin\".\"revenue\" as \"revenue\"
FROM
    \"users\" as \"user_users\"
    LEFT OUTER JOIN \"highfalutin\" on \"user_users\".\"id\" = \"highfalutin\".\"user_id\"
ORDER BY 
    coalesce(\"highfalutin\".\"user_id\",\"user_users\".\"id\") asc"""
