generated_sql = """
SELECT
    coalesce(\"order_items\".\"user_id\",\"user_users\".\"id\") as \"user_id\",
    \"product_products\".\"id\" as \"product_id\",
    sum(\"order_items\".\"sale_price\") as \"revenue\",
    sum(\"order_items\".\"sale_price\" - \"product_products\".\"cost\") as \"margin\"
FROM
    \"products\" as \"product_products\"
    LEFT OUTER JOIN \"order_items\" as \"order_items\" on \"product_products\".\"id\" = \"order_items\".\"product_id\"
    FULL JOIN \"users\" as \"user_users\" on \"order_items\".\"user_id\" = \"user_users\".\"id\"
GROUP BY
    1,
    2
ORDER BY 
    coalesce(\"order_items\".\"user_id\",\"user_users\".\"id\") asc nulls first,
    \"product_products\".\"id\" asc nulls first"""
