# Ship modes: carrier plus delivery-speed tier.

key sk int; # surrogate key

properties sk (
    id string, # business identifier
    type enum<string>['EXPRESS', 'LIBRARY', 'NEXT DAY', 'OVERNIGHT', 'REGULAR', 'TWO DAY'], # Delivery-speed tier.
    carrier string?, # e.g. 'UPS', 'FEDEX', 'USPS'.
);

datasource ship_mode (
    SM_SHIP_MODE_SK: sk,
    SM_SHIP_MODE_ID: id,
    SM_TYPE: type,
    SM_CARRIER: carrier,
)
grain (sk)
address memory.ship_mode;
