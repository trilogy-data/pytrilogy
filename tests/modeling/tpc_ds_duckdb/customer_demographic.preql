# Customer demographic profiles.

key sk int; # surrogate key

properties sk (
    gender enum<string>['M', 'F'],
    marital_status enum<string>['M', 'S', 'D', 'W', 'U'], # M=married, S=single, D=divorced, W=widowed, U=unknown.
    education_status enum<string>['Primary', 'Secondary', 'College', '2 yr Degree', '4 yr Degree', 'Advanced Degree', 'Unknown'],
    purchase_estimate int, # Modeled annual purchase estimate, bucketed in $500 increments (500-10000).
    credit_rating enum<string>['Low Risk', 'Good', 'High Risk', 'Unknown'],
    dependent_count int,
    employed_dependent_count int,
    college_dependent_count int,
);

datasource customer_demographics (
    CD_DEMO_SK: sk,
    CD_GENDER: gender,
    CD_MARITAL_STATUS: marital_status,
    CD_EDUCATION_STATUS: education_status,
    CD_PURCHASE_ESTIMATE: purchase_estimate,
    CD_CREDIT_RATING: credit_rating,
    CD_DEP_COUNT: dependent_count,
    CD_DEP_EMPLOYED_COUNT: employed_dependent_count,
    CD_DEP_COLLEGE_COUNT: college_dependent_count,
)
grain (sk)
address memory.customer_demographics;
