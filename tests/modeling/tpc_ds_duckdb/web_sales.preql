# For cross-channel questions, prefer `all_sales` (combines this with store_sales and catalog_sales).
# Web channel sales AND returns at (item, order_number) grain — the single model
# for all web-channel analysis, including returns-only questions. Return columns
# are NULL on lines never returned.

import std.money;

import item as item;
import date as sale_date;
import date as ship_date;
import date as return_date;
import time as sale_time;
import time as return_time;
import customer as billing_customer; # bill-to customer (latest/current record)
import customer as ship_customer; # ship-to customer (latest/current record)
import customer as return_customer;
import customer as return_refund_customer; # refund recipient; may differ from return_customer
import customer_demographic as return_customer_demographic; # returning customer's demographics AS OF the return, not their current record
import customer_demographic as return_refund_customer_demographic; # refunded customer's demographics AS OF the return, not their current record
import household_demographic as return_household_demographic; # returning customer's household demographics AS OF the return, not their current record
import household_demographic as return_refund_household_demographic; # refunded customer's household demographics AS OF the return, not their current record
import address as return_address; # where the return originated
import address as return_refund_address; # where the refund was issued
import reason as return_reason;
import web_site as web_site;
import web_page as web_page;
import web_page as return_web_page;
import promotion as promotion;
import warehouse as warehouse;
import ship_mode as ship_mode;
import address as pos_ship_address; # recorded on the sale at point of sale
import address as pos_bill_address; # recorded on the sale at point of sale
import household_demographic as pos_ship_household_demographic; # recorded at point of sale
import household_demographic as pos_bill_household_demographic; # recorded at point of sale

key order_number int; # identifies a single web sales transaction
--key return_order_number int; # Web order number on the returns side, for return-only queries.

properties <order_number, item.sk> (
    quantity int,
    sales_price numeric::usd, # Per-unit "unit price" charged; the whole-line total is ext_sales_price.
    list_price numeric::usd, # Per-unit, before discounts.
    wholesale_cost numeric::usd, # Per-unit.
    net_profit numeric::usd, # Reported net profit. Distinct from derived `profit`; use net_profit for "net profit" questions.
    net_paid numeric::usd, # Excludes tax/shipping.
    ext_sales_price numeric(15,2)::usd, # Whole-line "total price" = sales_price x quantity; per-unit price is sales_price.
    ext_list_price numeric::usd,
    ext_wholesale_cost numeric::usd,
    ext_ship_cost numeric::usd?,
    ext_discount_amount numeric::usd?,
    return_amount numeric::usd, # Refund excluding tax.
    return_net_loss numeric::usd?,
    return_quantity int?,
    return_tax numeric::usd?,
    return_amount_inc_tax numeric::usd?,
    return_fee numeric::usd?, # Restocking/handling fee withheld from the refund.
    return_ship_cost numeric::usd?,
    refunded_cash numeric::usd?,
    reversed_charge numeric::usd?, # Refund portion reversed on the original payment method.
    account_credit numeric::usd?,
    _returned_order_number int?, # Internal; NULL when not returned. Use is_returned instead.
    row_counter int, # Constant 1 per line item.
);

auto line_item <- concat(order_number::string, '-', item.sk::string); # Unique line-item id. Count line items with count(line_item), NOT count(order_number) (dedups multi-item orders).
auto line_item_count <- sum(row_counter); # = count(line_item); kept for queries that reference it.
auto days_to_ship <- date_diff(sale_date.date, ship_date.date, day); # Positive when shipped after sold.

auto is_returned <- _returned_order_number is not null; # Computed post-join from a real (NULL-padded) web_returns column, so "not returned" works as `= false` / `is not true` / `is null`.
auto profit <- ext_list_price - ext_wholesale_cost - ext_discount_amount + ext_sales_price; # Derived line "gross value". NOT the reported net_profit column.

datasource web_sales (
    raw('''1'''): row_counter,
    WS_SOLD_DATE_SK: ?sale_date.sk,
    WS_SOLD_TIME_SK: ?sale_time.sk,
    WS_SHIP_DATE_SK: ?ship_date.sk,
    WS_BILL_CUSTOMER_SK: ?billing_customer.sk,
    WS_SHIP_CUSTOMER_SK: ?ship_customer.sk,
    WS_ORDER_NUMBER: order_number,
    WS_ITEM_SK: item.sk,
    WS_QUANTITY: quantity,
    WS_SALES_PRICE: sales_price,
    WS_WHOLESALE_COST: wholesale_cost,
    WS_EXT_SALES_PRICE: ext_sales_price,
    WS_EXT_LIST_PRICE: ext_list_price,
    WS_EXT_WHOLESALE_COST: ext_wholesale_cost,
    WS_EXT_SHIP_COST: ext_ship_cost,
    WS_NET_PROFIT: net_profit,
    WS_WEB_SITE_SK: ?web_site.sk,
    WS_WEB_PAGE_SK: ?web_page.sk,
    WS_PROMO_SK: ?promotion.sk,
    WS_WAREHOUSE_SK: ?warehouse.sk,
    WS_SHIP_ADDR_SK: ?pos_ship_address.sk,
    WS_BILL_ADDR_SK: ?pos_bill_address.sk,
    WS_SHIP_MODE_SK: ?ship_mode.sk,
    WS_EXT_DISCOUNT_AMT: ext_discount_amount,
    WS_SHIP_HDEMO_SK: ?pos_ship_household_demographic.sk,
    WS_BILL_HDEMO_SK: ?pos_bill_household_demographic.sk,
    WS_NET_PAID: net_paid,
    WS_LIST_PRICE: list_price,
)
grain (item.sk, order_number)
address memory.web_sales;

datasource web_returns (
    WR_RETURNED_DATE_SK: return_date.sk,
    WR_RETURNED_TIME_SK: return_time.sk,
    WR_ITEM_SK: ~item.sk,
    WR_RETURNING_CUSTOMER_SK: return_customer.sk,
    WR_REFUNDED_CUSTOMER_SK: return_refund_customer.sk,
    WR_RETURNING_CDEMO_SK: ?return_customer_demographic.sk,
    WR_REFUNDED_CDEMO_SK: ?return_refund_customer_demographic.sk,
    WR_RETURNING_HDEMO_SK: ?return_household_demographic.sk,
    WR_REFUNDED_HDEMO_SK: ?return_refund_household_demographic.sk,
    WR_RETURNING_ADDR_SK: ?return_address.sk,
    WR_REFUNDED_ADDR_SK: ?return_refund_address.sk,
    WR_REASON_SK: ?return_reason.sk,
    WR_WEB_PAGE_SK: ?return_web_page.sk,
    WR_ORDER_NUMBER: ~order_number,
    WR_RETURN_AMT: return_amount,
    WR_RETURN_TAX: return_tax,
    WR_RETURN_AMT_INC_TAX: return_amount_inc_tax,
    WR_FEE: return_fee,
    WR_RETURN_SHIP_COST: return_ship_cost,
    WR_REFUNDED_CASH: refunded_cash,
    WR_REVERSED_CHARGE: reversed_charge,
    WR_ACCOUNT_CREDIT: account_credit,
    WR_NET_LOSS: return_net_loss,
    WR_RETURN_QUANTITY: return_quantity,
    WR_ORDER_NUMBER: _returned_order_number, # Real column (NULL-padded by the LEFT join) backing is_returned.
)
grain (item.sk, order_number)
address memory.web_returns;
