generated_sql = """

WITH 
thoughtful as (
SELECT
    \"ss_store_returns\".\"SR_CDEMO_SK\" as \"customer_current_demographics_sk\"
FROM
    \"memory\".\"store_returns\" as \"ss_store_returns\"
WHERE
    coalesce(\"ss_store_returns\".\"SR_CDEMO_SK\") is not null and (\"ss_store_returns\".\"SR_TICKET_NUMBER\" is not null)
)
SELECT
    \"customer_customers\".\"C_CUSTOMER_ID\" as \"customer_id\",
    CONCAT(coalesce(\"customer_customers\".\"C_LAST_NAME\",''), ', ', coalesce(\"customer_customers\".\"C_FIRST_NAME\",'')) as \"customername\"
FROM
    \"memory\".\"customer\" as \"customer_customers\"
    INNER JOIN \"thoughtful\" on \"customer_customers\".\"C_CURRENT_CDEMO_SK\" is not distinct from \"thoughtful\".\"customer_current_demographics_sk\"
    INNER JOIN \"memory\".\"customer_address\" as \"customer_current_address_customer_address\" on \"customer_customers\".\"C_CURRENT_ADDR_SK\" = \"customer_current_address_customer_address\".\"CA_ADDRESS_SK\"
    INNER JOIN \"memory\".\"household_demographics\" as \"customer_current_household_demographics_household_demographics\" on \"customer_customers\".\"C_CURRENT_HDEMO_SK\" = \"customer_current_household_demographics_household_demographics\".\"HD_DEMO_SK\"
    INNER JOIN \"memory\".\"income_band\" as \"customer_current_household_demographics_income_band_income_band\" on \"customer_current_household_demographics_household_demographics\".\"HD_INCOME_BAND_SK\" = \"customer_current_household_demographics_income_band_income_band\".\"IB_INCOME_BAND_SK\"
WHERE
    \"customer_current_address_customer_address\".\"CA_CITY\" = 'Edgewood' and \"customer_current_household_demographics_income_band_income_band\".\"IB_LOWER_BOUND\" >= 38128 and \"customer_current_household_demographics_income_band_income_band\".\"IB_UPPER_BOUND\" <= 38128 + 50000

ORDER BY 
    \"customer_customers\".\"C_CUSTOMER_ID\" asc nulls first
LIMIT (100)"""
