generated_sql = """

WITH 
wakeful as (
SELECT
    \"ss_sale_date_date\".\"D_DAY_NAME\" as \"ss_sale_date_day_name\",
    \"ss_sale_date_date\".\"D_MONTH_SEQ\" as \"ss_sale_date_month_seq\",
    \"ss_sale_date_date\".\"D_WEEK_SEQ\" as \"ss_sale_date_week_seq\",
    \"ss_store_sales\".\"SS_SALES_PRICE\" as \"ss_sales_price\",
    \"ss_store_sales\".\"SS_SOLD_DATE_SK\" as \"ss_sale_date_sk\",
    \"ss_store_sales\".\"SS_STORE_SK\" as \"ss_store_sk\"
FROM
    \"memory\".\"store_sales\" as \"ss_store_sales\"
    INNER JOIN \"memory\".\"date_dim\" as \"ss_sale_date_date\" on \"ss_store_sales\".\"SS_SOLD_DATE_SK\" = \"ss_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"ss_sale_date_date\".\"D_MONTH_SEQ\" BETWEEN 1212 AND 1235 and \"ss_store_sales\".\"SS_STORE_SK\" is not null
),
questionable as (
SELECT
    \"wakeful\".\"ss_sale_date_week_seq\" as \"ss_sale_date_week_seq\",
    \"wakeful\".\"ss_store_sk\" as \"ss_store_sk\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Friday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"fri_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Monday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"mon_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Saturday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"sat_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Sunday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"sun_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Thursday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"thu_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Tuesday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"tue_sales\",
    sum(CASE WHEN \"wakeful\".\"ss_sale_date_day_name\" = 'Wednesday' THEN \"wakeful\".\"ss_sales_price\" ELSE NULL END) as \"wed_sales\"
FROM
    \"wakeful\"
GROUP BY
    1,
    2),
cheerful as (
SELECT
    \"wakeful\".\"ss_sale_date_month_seq\" as \"ss_sale_date_month_seq\",
    \"wakeful\".\"ss_sale_date_week_seq\" as \"ss_sale_date_week_seq\",
    \"wakeful\".\"ss_store_sk\" as \"ss_store_sk\"
FROM
    \"wakeful\"
GROUP BY
    1,
    2,
    3,
    \"wakeful\".\"ss_sale_date_sk\"),
thoughtful as (
SELECT
    \"cheerful\".\"ss_sale_date_week_seq\" - (CASE
	WHEN max(CASE
	WHEN \"cheerful\".\"ss_sale_date_month_seq\" BETWEEN 1212 AND 1223 THEN 1
	WHEN \"cheerful\".\"ss_sale_date_month_seq\" BETWEEN 1224 AND 1235 THEN 2
	ELSE 0
	END) = 2 THEN 52
	ELSE 0
	END) as \"normalized_week\",
    \"cheerful\".\"ss_sale_date_week_seq\" as \"ss_sale_date_week_seq\",
    \"cheerful\".\"ss_store_sk\" as \"ss_store_sk\",
    max(CASE
	WHEN \"cheerful\".\"ss_sale_date_month_seq\" BETWEEN 1212 AND 1223 THEN 1
	WHEN \"cheerful\".\"ss_sale_date_month_seq\" BETWEEN 1224 AND 1235 THEN 2
	ELSE 0
	END) as \"year_flag\"
FROM
    \"cheerful\"
GROUP BY
    2,
    3),
abundant as (
SELECT
    \"questionable\".\"fri_sales\" / nullif(lead(\"questionable\".\"fri_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"fri_sales_ratio\",
    \"questionable\".\"mon_sales\" / nullif(lead(\"questionable\".\"mon_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"mon_sales_ratio\",
    \"questionable\".\"sat_sales\" / nullif(lead(\"questionable\".\"sat_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"sat_sales_ratio\",
    \"questionable\".\"sun_sales\" / nullif(lead(\"questionable\".\"sun_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"sun_sales_ratio\",
    \"questionable\".\"thu_sales\" / nullif(lead(\"questionable\".\"thu_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"thu_sales_ratio\",
    \"questionable\".\"tue_sales\" / nullif(lead(\"questionable\".\"tue_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"tue_sales_ratio\",
    \"questionable\".\"wed_sales\" / nullif(lead(\"questionable\".\"wed_sales\", 1) over (partition by \"thoughtful\".\"ss_store_sk\",\"thoughtful\".\"normalized_week\" order by \"thoughtful\".\"year_flag\" asc ), 0) as \"wed_sales_ratio\",
    \"thoughtful\".\"ss_sale_date_week_seq\" as \"ss_sale_date_week_seq\",
    \"thoughtful\".\"ss_store_sk\" as \"ss_store_sk\",
    \"thoughtful\".\"year_flag\" as \"year_flag\"
FROM
    \"questionable\"
    INNER JOIN \"thoughtful\" on \"questionable\".\"ss_sale_date_week_seq\" = \"thoughtful\".\"ss_sale_date_week_seq\" AND \"questionable\".\"ss_store_sk\" = \"thoughtful\".\"ss_store_sk\"),
yummy as (
SELECT
    \"abundant\".\"fri_sales_ratio\" as \"fri_sales_ratio\",
    \"abundant\".\"mon_sales_ratio\" as \"mon_sales_ratio\",
    \"abundant\".\"sat_sales_ratio\" as \"sat_sales_ratio\",
    \"abundant\".\"ss_sale_date_week_seq\" as \"d_week_seq1\",
    \"abundant\".\"ss_store_sk\" as \"ss_store_sk\",
    \"abundant\".\"sun_sales_ratio\" as \"sun_sales_ratio\",
    \"abundant\".\"thu_sales_ratio\" as \"thu_sales_ratio\",
    \"abundant\".\"tue_sales_ratio\" as \"tue_sales_ratio\",
    \"abundant\".\"wed_sales_ratio\" as \"wed_sales_ratio\",
    \"abundant\".\"year_flag\" as \"year_flag\"
FROM
    \"abundant\")
SELECT
    \"ss_store_store\".\"S_STORE_NAME\" as \"s_store_name1\",
    \"ss_store_store\".\"S_STORE_ID\" as \"s_store_id1\",
    \"yummy\".\"d_week_seq1\" as \"d_week_seq1\",
    \"yummy\".\"sun_sales_ratio\" as \"sun_sales_ratio\",
    \"yummy\".\"mon_sales_ratio\" as \"mon_sales_ratio\",
    \"yummy\".\"tue_sales_ratio\" as \"tue_sales_ratio\",
    \"yummy\".\"wed_sales_ratio\" as \"wed_sales_ratio\",
    \"yummy\".\"thu_sales_ratio\" as \"thu_sales_ratio\",
    \"yummy\".\"fri_sales_ratio\" as \"fri_sales_ratio\",
    \"yummy\".\"sat_sales_ratio\" as \"sat_sales_ratio\"
FROM
    \"yummy\"
    INNER JOIN \"memory\".\"store\" as \"ss_store_store\" on \"yummy\".\"ss_store_sk\" = \"ss_store_store\".\"S_STORE_SK\"
WHERE
    \"yummy\".\"year_flag\" = 1 and \"yummy\".\"sun_sales_ratio\" is not null

ORDER BY 
    \"s_store_name1\" asc nulls first,
    \"s_store_id1\" asc nulls first,
    \"yummy\".\"d_week_seq1\" asc nulls first
LIMIT (100)"""
