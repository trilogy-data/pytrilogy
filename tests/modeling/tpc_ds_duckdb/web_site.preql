# Web sites: the operator/company for each web storefront.

key sk int; # surrogate key

properties sk (
    id string, # business identifier
    company_name string,
    name string?,
);

datasource web_site (
    web_site_sk: sk,
    web_site_id: id,
    web_company_name: company_name,
    web_name: name,
)
grain (sk)
address memory.web_site;
