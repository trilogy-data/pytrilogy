    \"young\".\"ws_return_customer_birth_month\" as \"ws_return_customer_birth_month\",
    \"young\".\"ws_return_customer_birth_year\" as \"ws_return_customer_birth_year\",
    \"young\".\"ws_return_customer_birth_country\" as \"ws_return_customer_birth_country\",
    \"young\".\"ws_return_customer_login\" as \"ws_return_customer_login\",
    \"young\".\"ws_return_customer_email_address\" as \"ws_return_customer_email_address\",
    \"young\".\"ws_return_customer_last_review_date\" as \"ws_return_customer_last_review_date\",
    \"uneven\".\"customer_state_returns_2002\" as \"customer_state_returns_2002\"
