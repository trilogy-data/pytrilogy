generated_sql = """

WITH 
cheerful as (
SELECT
    \"ss_store_sales\".\"SS_NET_PROFIT\" as \"ss_net_profit\",
    \"ss_store_store\".\"S_COUNTY\" as \"ss_store_county\",
    \"ss_store_store\".\"S_STATE\" as \"ss_store_state\"
FROM
    \"memory\".\"store_sales\" as \"ss_store_sales\"
    INNER JOIN \"memory\".\"store\" as \"ss_store_store\" on \"ss_store_sales\".\"SS_STORE_SK\" = \"ss_store_store\".\"S_STORE_SK\"
    INNER JOIN \"memory\".\"date_dim\" as \"ss_sale_date_date\" on \"ss_store_sales\".\"SS_SOLD_DATE_SK\" = \"ss_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"ss_sale_date_date\".\"D_MONTH_SEQ\" BETWEEN 1200 AND 1211 and \"ss_store_store\".\"S_STATE\" is not null
),
thoughtful as (
SELECT
    \"cheerful\".\"ss_store_state\" as \"ss_store_state\",
    sum(\"cheerful\".\"ss_net_profit\") as \"state_total\"
FROM
    \"cheerful\"
GROUP BY
    1),
cooperative as (
SELECT
    \"thoughtful\".\"ss_store_state\" as \"ss_store_state\",
    rank() over (order by \"thoughtful\".\"state_total\" desc ) as \"state_rnk\"
FROM
    \"thoughtful\"),
questionable as (
SELECT
    \"cheerful\".\"ss_net_profit\" as \"ss_net_profit\",
    \"cheerful\".\"ss_store_county\" as \"ss_store_county\",
    \"cheerful\".\"ss_store_state\" as \"ss_store_state\",
    \"cooperative\".\"state_rnk\" as \"state_rnk\"
FROM
    \"cheerful\"
    INNER JOIN \"cooperative\" on \"cheerful\".\"ss_store_state\" = \"cooperative\".\"ss_store_state\"),
abundant as (
SELECT
    \"questionable\".\"ss_net_profit\" as \"ss_net_profit\",
    \"questionable\".\"ss_store_county\" as \"ss_store_county\",
    \"questionable\".\"ss_store_state\" as \"ss_store_state\"
FROM
    \"questionable\"
WHERE
    \"questionable\".\"state_rnk\" <= 5
),
uneven as (
SELECT
    \"abundant\".\"ss_net_profit\" as \"ss_net_profit\",
    \"abundant\".\"ss_store_county\" as \"ss_store_county\",
    \"abundant\".\"ss_store_state\" as \"ss_store_state\"
FROM
    \"abundant\"),
yummy as (
SELECT
    \"uneven\".\"ss_store_county\" as \"ss_store_county\",
    \"uneven\".\"ss_store_state\" as \"ss_store_state\",
    grouping(\"uneven\".\"ss_store_county\") as \"g_county\",
    grouping(\"uneven\".\"ss_store_state\") as \"g_state\",
    sum(\"uneven\".\"ss_net_profit\") as \"total_sum\"
FROM
    \"uneven\"
GROUP BY
    ROLLUP (2, 1)),
juicy as (
SELECT
    \"yummy\".\"g_state\" + \"yummy\".\"g_county\" as \"lochierarchy\",
    \"yummy\".\"ss_store_county\" as \"ss_store_county\",
    \"yummy\".\"ss_store_state\" as \"ss_store_state\",
    \"yummy\".\"total_sum\" as \"total_sum\",
    rank() over (partition by \"yummy\".\"g_state\" + \"yummy\".\"g_county\",CASE
	WHEN \"yummy\".\"g_county\" = 0 THEN \"yummy\".\"ss_store_state\"
	ELSE null
	END order by \"yummy\".\"total_sum\" desc ) as \"rank_within_parent\"
FROM
    \"yummy\")
SELECT
    \"juicy\".\"total_sum\" as \"total_sum\",
    \"juicy\".\"ss_store_state\" as \"s_state\",
    \"juicy\".\"ss_store_county\" as \"s_county\",
    \"juicy\".\"lochierarchy\" as \"lochierarchy\",
    \"juicy\".\"rank_within_parent\" as \"rank_within_parent\"
FROM
    \"juicy\"
ORDER BY 
    \"juicy\".\"lochierarchy\" desc nulls first,
    CASE
	WHEN \"juicy\".\"lochierarchy\" = 0 THEN \"juicy\".\"ss_store_state\"
	ELSE null
	END asc nulls first,
    \"juicy\".\"rank_within_parent\" asc nulls first
LIMIT (100)"""
