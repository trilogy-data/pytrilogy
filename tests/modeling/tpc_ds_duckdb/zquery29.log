generated_sql = """

WITH 
vacuous as (
SELECT
    \"store_sales_return_date_date\".\"D_MOY\" as \"store_sales_return_date_month_of_year\",
    \"store_sales_return_date_date\".\"D_YEAR\" as \"store_sales_return_date_year\",
    \"store_sales_sale_date_date\".\"D_MOY\" as \"store_sales_sale_date_month_of_year\",
    \"store_sales_sale_date_date\".\"D_YEAR\" as \"store_sales_sale_date_year\",
    \"store_sales_store_returns\".\"SR_CUSTOMER_SK\" as \"store_sales_return_customer_sk\",
    \"store_sales_store_returns\".\"SR_RETURN_QUANTITY\" as \"store_sales_return_quantity\",
    \"store_sales_store_sales\".\"SS_CUSTOMER_SK\" as \"catalog_customer_item_cat_customer_sk\",
    \"store_sales_store_sales\".\"SS_CUSTOMER_SK\" as \"store_sales_customer_sk\",
    \"store_sales_store_sales\".\"SS_QUANTITY\" as \"store_sales_quantity\",
    \"store_sales_store_store\".\"S_STORE_ID\" as \"store_sales_store_id\",
    \"store_sales_store_store\".\"S_STORE_NAME\" as \"store_sales_store_name\",
    coalesce(\"store_sales_store_returns\".\"SR_ITEM_SK\",\"store_sales_store_sales\".\"SS_ITEM_SK\") as \"catalog_customer_item_cat_item_sk\",
    coalesce(\"store_sales_store_returns\".\"SR_ITEM_SK\",\"store_sales_store_sales\".\"SS_ITEM_SK\") as \"store_sales_item_sk\",
    coalesce(\"store_sales_store_returns\".\"SR_TICKET_NUMBER\",\"store_sales_store_sales\".\"SS_TICKET_NUMBER\") as \"store_sales_ticket_number\"
FROM
    \"memory\".\"store_sales\" as \"store_sales_store_sales\"
    LEFT OUTER JOIN \"memory\".\"store_returns\" as \"store_sales_store_returns\" on \"store_sales_store_sales\".\"SS_ITEM_SK\" = \"store_sales_store_returns\".\"SR_ITEM_SK\" AND \"store_sales_store_sales\".\"SS_TICKET_NUMBER\" = \"store_sales_store_returns\".\"SR_TICKET_NUMBER\"
    FULL JOIN \"memory\".\"store\" as \"store_sales_store_store\" on \"store_sales_store_sales\".\"SS_STORE_SK\" = \"store_sales_store_store\".\"S_STORE_SK\"
    RIGHT OUTER JOIN \"memory\".\"date_dim\" as \"store_sales_sale_date_date\" on \"store_sales_store_sales\".\"SS_SOLD_DATE_SK\" = \"store_sales_sale_date_date\".\"D_DATE_SK\"
    LEFT OUTER JOIN \"memory\".\"date_dim\" as \"store_sales_return_date_date\" on \"store_sales_store_returns\".\"SR_RETURNED_DATE_SK\" = \"store_sales_return_date_date\".\"D_DATE_SK\"
WHERE
    \"store_sales_sale_date_date\".\"D_MOY\" = 9 and \"store_sales_sale_date_date\".\"D_YEAR\" = 1999
),
macho as (
SELECT
    \"store_sales_item_items\".\"I_ITEM_DESC\" as \"_per_pair_item_desc\",
    \"store_sales_item_items\".\"I_ITEM_ID\" as \"_per_pair_item_id\",
    \"store_sales_item_items\".\"I_ITEM_SK\" as \"_per_pair_item_sk\",
    \"vacuous\".\"store_sales_customer_sk\" as \"_per_pair_customer_sk\",
    \"vacuous\".\"store_sales_store_id\" as \"_per_pair_store_text_id\",
    \"vacuous\".\"store_sales_store_name\" as \"_per_pair_store_name\"
FROM
    \"memory\".\"item\" as \"store_sales_item_items\"
    RIGHT OUTER JOIN \"vacuous\" on \"store_sales_item_items\".\"I_ITEM_SK\" = \"vacuous\".\"store_sales_item_sk\"),
concerned as (
SELECT
    (\"store_sales_store_returns\".\"SR_TICKET_NUMBER\" is not null) as \"store_sales_is_returned\",
    coalesce(\"store_sales_store_returns\".\"SR_ITEM_SK\",\"store_sales_store_sales\".\"SS_ITEM_SK\") as \"catalog_customer_item_cat_item_sk\",
    coalesce(\"store_sales_store_returns\".\"SR_ITEM_SK\",\"store_sales_store_sales\".\"SS_ITEM_SK\") as \"store_sales_item_sk\",
    coalesce(\"store_sales_store_returns\".\"SR_TICKET_NUMBER\",\"store_sales_store_sales\".\"SS_TICKET_NUMBER\") as \"store_sales_ticket_number\"
FROM
    \"memory\".\"store_sales\" as \"store_sales_store_sales\"
    INNER JOIN \"memory\".\"store_returns\" as \"store_sales_store_returns\" on \"store_sales_store_sales\".\"SS_ITEM_SK\" = \"store_sales_store_returns\".\"SR_ITEM_SK\" AND \"store_sales_store_sales\".\"SS_TICKET_NUMBER\" = \"store_sales_store_returns\".\"SR_TICKET_NUMBER\"
WHERE
    \"store_sales_store_sales\".\"SS_CUSTOMER_SK\" = \"store_sales_store_returns\".\"SR_CUSTOMER_SK\"
),
wakeful as (
SELECT
    \"catalog_sales_catalog_sales\".\"CS_BILL_CUSTOMER_SK\" as \"catalog_customer_item_cat_customer_sk\",
    \"catalog_sales_catalog_sales\".\"CS_ITEM_SK\" as \"catalog_customer_item_cat_item_sk\",
    sum(\"catalog_sales_catalog_sales\".\"CS_QUANTITY\") as \"catalog_customer_item_cat_quantity\"
FROM
    \"memory\".\"catalog_sales\" as \"catalog_sales_catalog_sales\"
    INNER JOIN \"memory\".\"date_dim\" as \"catalog_sales_sale_date_date\" on \"catalog_sales_catalog_sales\".\"CS_SOLD_DATE_SK\" = \"catalog_sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    (\"catalog_sales_sale_date_date\".\"D_YEAR\" is not null and \"catalog_sales_sale_date_date\".\"D_YEAR\" in (1999,2000,2001))

GROUP BY
    1,
    2),
sparkling as (
SELECT
    \"vacuous\".\"store_sales_store_id\" as \"store_sales_store_id\",
    \"vacuous\".\"store_sales_store_name\" as \"store_sales_store_name\",
    coalesce(\"vacuous\".\"catalog_customer_item_cat_item_sk\",\"vacuous\".\"store_sales_item_sk\",\"wakeful\".\"catalog_customer_item_cat_item_sk\") as \"store_sales_item_sk\",
    coalesce(\"vacuous\".\"store_sales_customer_sk\",\"wakeful\".\"catalog_customer_item_cat_customer_sk\") as \"store_sales_customer_sk\",
    max(\"wakeful\".\"catalog_customer_item_cat_quantity\") as \"_per_pair_cq\",
    sum(\"vacuous\".\"store_sales_quantity\") as \"_per_pair_sq\",
    sum(\"vacuous\".\"store_sales_return_quantity\") as \"_per_pair_srq\"
FROM
    \"wakeful\"
    INNER JOIN \"vacuous\" on \"wakeful\".\"catalog_customer_item_cat_customer_sk\" = \"vacuous\".\"store_sales_customer_sk\" AND \"wakeful\".\"catalog_customer_item_cat_item_sk\" = \"vacuous\".\"store_sales_item_sk\"
    LEFT OUTER JOIN \"concerned\" on \"vacuous\".\"store_sales_ticket_number\" is not distinct from \"concerned\".\"store_sales_ticket_number\" AND coalesce(\"wakeful\".\"catalog_customer_item_cat_item_sk\", \"vacuous\".\"store_sales_item_sk\") is not distinct from \"concerned\".\"store_sales_item_sk\"
WHERE
    \"concerned\".\"store_sales_is_returned\" and \"vacuous\".\"store_sales_return_date_month_of_year\" BETWEEN 9 AND 12 and \"vacuous\".\"store_sales_return_date_year\" = 1999 and coalesce(\"vacuous\".\"store_sales_customer_sk\",\"wakeful\".\"catalog_customer_item_cat_customer_sk\") = \"vacuous\".\"store_sales_return_customer_sk\" and \"wakeful\".\"catalog_customer_item_cat_quantity\" > 0 and \"vacuous\".\"store_sales_sale_date_month_of_year\" = 9 and \"vacuous\".\"store_sales_sale_date_year\" = 1999

GROUP BY
    1,
    2,
    3,
    4),
friendly as (
SELECT
    \"macho\".\"_per_pair_item_desc\" as \"per_pair_item_desc\",
    \"macho\".\"_per_pair_item_id\" as \"per_pair_item_id\",
    \"macho\".\"_per_pair_store_name\" as \"per_pair_store_name\",
    \"macho\".\"_per_pair_store_text_id\" as \"per_pair_store_text_id\",
    \"sparkling\".\"_per_pair_cq\" as \"per_pair_cq\",
    \"sparkling\".\"_per_pair_sq\" as \"per_pair_sq\",
    \"sparkling\".\"_per_pair_srq\" as \"per_pair_srq\"
FROM
    \"sparkling\"
    INNER JOIN \"macho\" on \"sparkling\".\"store_sales_customer_sk\" = \"macho\".\"_per_pair_customer_sk\" AND \"sparkling\".\"store_sales_item_sk\" = \"macho\".\"_per_pair_item_sk\" AND \"sparkling\".\"store_sales_store_id\" is not distinct from \"macho\".\"_per_pair_store_text_id\" AND \"sparkling\".\"store_sales_store_name\" is not distinct from \"macho\".\"_per_pair_store_name\"
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    \"macho\".\"_per_pair_customer_sk\",
    \"macho\".\"_per_pair_item_sk\")
SELECT
    \"friendly\".\"per_pair_item_id\" as \"store_sales_item_name\",
    \"friendly\".\"per_pair_item_desc\" as \"store_sales_item_desc\",
    \"friendly\".\"per_pair_store_text_id\" as \"store_sales_store_text_id\",
    \"friendly\".\"per_pair_store_name\" as \"store_name\",
    sum(\"friendly\".\"per_pair_sq\") as \"store_sales_quantity\",
    sum(\"friendly\".\"per_pair_srq\") as \"store_returns_quantity\",
    sum(\"friendly\".\"per_pair_cq\") as \"catalog_sales_quantity\"
FROM
    \"friendly\"
GROUP BY
    1,
    2,
    3,
    4
ORDER BY 
    \"store_sales_item_name\" asc,
    \"store_sales_item_desc\" asc,
    \"store_sales_store_text_id\" asc,
    \"store_name\" asc
LIMIT (100)"""
