# Call centers handling catalog and web orders.

key sk int; # surrogate key

properties sk (
    id string, # business identifier
    county string,
    name string,
    manager string?,
);

datasource call_center (
    CC_CALL_CENTER_SK: sk,
    CC_CALL_CENTER_ID: id,
    CC_COUNTY: county,
    CC_NAME: name,
    CC_MANAGER: manager,
)
grain (sk)
address memory.call_center;
