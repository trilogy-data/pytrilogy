import all_sales as s;

const period_start <- '2000-08-23'::date;
const period_end <- '2000-09-06'::date;

# A sale rolls up to its sale entity and a return to its RETURN entity (a
# catalog return can land on a different page than its sale), so each side is
# its own arm, mirroring the reference's sales UNION ALL returns.
with entity_rows as union(
    (where s.sale_date.date between period_start and period_end
        and s.channel_dim_text_id is not null
     select
        s.channel as u_channel,
        s.channel_dim_text_id as u_entity,
        sum(s.ext_sales_price)::numeric(15,2) as u_sales,
        0::numeric(15,2) as u_returns,
        sum(s.net_profit)::numeric(15,2) as u_profit,
    ),
    (where s.return_date.date between period_start and period_end
        and s.return_channel_dim_text_id is not null
     select
        s.channel as u_channel,
        s.return_channel_dim_text_id as u_entity,
        0::numeric(15,2) as u_sales,
        sum(s.return_amount)::numeric(15,2) as u_returns,
        (0 - sum(s.return_net_loss))::numeric(15,2) as u_profit,
    )
) -> (u_channel, u_entity, u_sales, u_returns, u_profit);

auto channel_label <- case
    when entity_rows.u_channel = 'STORE' then 'store channel'
    when entity_rows.u_channel = 'CATALOG' then 'catalog channel'
    when entity_rows.u_channel = 'WEB' then 'web channel'
    else null
end;
auto entity_id <- case
    when entity_rows.u_channel = 'STORE' then 'store' || entity_rows.u_entity
    when entity_rows.u_channel = 'CATALOG' then 'catalog_page' || entity_rows.u_entity
    when entity_rows.u_channel = 'WEB' then 'web_site' || entity_rows.u_entity
    else null
end;

select
    channel_label,
    entity_id,
    sum(entity_rows.u_sales) as sales,
    sum(entity_rows.u_returns) as returns,
    sum(entity_rows.u_profit) as profit
by rollup (channel_label, entity_id)
order by
    channel_label NULLS FIRST,
    entity_id NULLS FIRST
limit 100
;
