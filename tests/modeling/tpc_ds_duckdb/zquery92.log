generated_sql = """

WITH 
thoughtful as (
SELECT
    \"ws_web_sales\".\"WS_ITEM_SK\" as \"ws_item_sk\",
    1.3 * avg(\"ws_web_sales\".\"WS_EXT_DISCOUNT_AMT\") as \"avg_item_disc\"
FROM
    \"memory\".\"web_sales\" as \"ws_web_sales\"
    INNER JOIN \"memory\".\"date_dim\" as \"ws_sale_date_date\" on \"ws_web_sales\".\"WS_SOLD_DATE_SK\" = \"ws_sale_date_date\".\"D_DATE_SK\"
WHERE
    CASE WHEN regexp_full_match(CAST(\"ws_sale_date_date\".\"D_DATE\" AS VARCHAR), '^[[:space:]]*[0-9][0-9][0-9][0-9](-[0-9][0-9]?-[0-9][0-9]?|/[0-9][0-9]?/[0-9][0-9]?)([ T]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?)?[[:space:]]*$') THEN TRY_CAST(trim(CAST(\"ws_sale_date_date\".\"D_DATE\" AS VARCHAR), ' ' || chr(9) || chr(10) || chr(13)) AS date) END BETWEEN :start_date AND :end_date

GROUP BY
    1),
cheerful as (
SELECT
    \"ws_item_items\".\"I_ITEM_SK\" as \"ws_item_sk\",
    \"ws_web_sales\".\"WS_EXT_DISCOUNT_AMT\" as \"ws_ext_discount_amount\"
FROM
    \"memory\".\"web_sales\" as \"ws_web_sales\"
    INNER JOIN \"memory\".\"item\" as \"ws_item_items\" on \"ws_web_sales\".\"WS_ITEM_SK\" = \"ws_item_items\".\"I_ITEM_SK\"
    INNER JOIN \"memory\".\"date_dim\" as \"ws_sale_date_date\" on \"ws_web_sales\".\"WS_SOLD_DATE_SK\" = \"ws_sale_date_date\".\"D_DATE_SK\"
WHERE
    CASE WHEN regexp_full_match(CAST(\"ws_sale_date_date\".\"D_DATE\" AS VARCHAR), '^[[:space:]]*[0-9][0-9][0-9][0-9](-[0-9][0-9]?-[0-9][0-9]?|/[0-9][0-9]?/[0-9][0-9]?)([ T]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?)?[[:space:]]*$') THEN TRY_CAST(trim(CAST(\"ws_sale_date_date\".\"D_DATE\" AS VARCHAR), ' ' || chr(9) || chr(10) || chr(13)) AS date) END BETWEEN :start_date AND :end_date and \"ws_item_items\".\"I_MANUFACT_ID\" = 350
)
SELECT
    sum(\"cheerful\".\"ws_ext_discount_amount\") as \"excess_discount_amount\"
FROM
    \"cheerful\"
    INNER JOIN \"thoughtful\" on \"cheerful\".\"ws_item_sk\" = \"thoughtful\".\"ws_item_sk\"
WHERE
    \"cheerful\".\"ws_ext_discount_amount\" > \"thoughtful\".\"avg_item_disc\"

HAVING
    count(*) > 0

ORDER BY 
    \"excess_discount_amount\" asc nulls first
LIMIT (100)"""
