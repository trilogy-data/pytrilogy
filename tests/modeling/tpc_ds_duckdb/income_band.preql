# Household-income range buckets: inclusive lower/upper dollar bounds.
import std.currency;

key sk int; # surrogate key

properties sk (
    lower_bound int::usd,
    upper_bound int::usd
);

datasource income_band (
    IB_INCOME_BAND_SK: sk,
    IB_LOWER_BOUND: lower_bound,
    IB_UPPER_BOUND: upper_bound,
)
grain (sk)
address memory.income_band;
