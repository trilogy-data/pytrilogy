generated_sql = """

WITH 
thoughtful as (
SELECT
    \"sales_catalog_sales_unified\".\"CS_BILL_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'CATALOG'  as \"sales_channel\",
    \"sales_catalog_sales_unified\".\"CS_EXT_DISCOUNT_AMT\" as \"sales_ext_discount_amount\",
    \"sales_catalog_sales_unified\".\"CS_EXT_LIST_PRICE\" as \"sales_ext_list_price\",
    \"sales_catalog_sales_unified\".\"CS_EXT_SALES_PRICE\" as \"sales_ext_sales_price\",
    \"sales_catalog_sales_unified\".\"CS_EXT_WHOLESALE_COST\" as \"sales_ext_wholesale_cost\",
    \"sales_sale_date_date\".\"D_YEAR\" as \"sales_sale_date_year\"
FROM
    \"memory\".\"catalog_sales\" as \"sales_catalog_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_catalog_sales_unified\".\"CS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    (2001 is not distinct from \"sales_sale_date_date\".\"D_YEAR\" or 2002 is not distinct from \"sales_sale_date_date\".\"D_YEAR\")

UNION ALL
SELECT
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'STORE'  as \"sales_channel\",
    \"sales_store_sales_unified\".\"SS_EXT_DISCOUNT_AMT\" as \"sales_ext_discount_amount\",
    \"sales_store_sales_unified\".\"SS_EXT_LIST_PRICE\" as \"sales_ext_list_price\",
    \"sales_store_sales_unified\".\"SS_EXT_SALES_PRICE\" as \"sales_ext_sales_price\",
    \"sales_store_sales_unified\".\"SS_EXT_WHOLESALE_COST\" as \"sales_ext_wholesale_cost\",
    \"sales_sale_date_date\".\"D_YEAR\" as \"sales_sale_date_year\"
FROM
    \"memory\".\"store_sales\" as \"sales_store_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_store_sales_unified\".\"SS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    (2001 is not distinct from \"sales_sale_date_date\".\"D_YEAR\" or 2002 is not distinct from \"sales_sale_date_date\".\"D_YEAR\")

UNION ALL
SELECT
    \"sales_web_sales_unified\".\"WS_BILL_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'WEB'  as \"sales_channel\",
    \"sales_web_sales_unified\".\"WS_EXT_DISCOUNT_AMT\" as \"sales_ext_discount_amount\",
    \"sales_web_sales_unified\".\"WS_EXT_LIST_PRICE\" as \"sales_ext_list_price\",
    \"sales_web_sales_unified\".\"WS_EXT_SALES_PRICE\" as \"sales_ext_sales_price\",
    \"sales_web_sales_unified\".\"WS_EXT_WHOLESALE_COST\" as \"sales_ext_wholesale_cost\",
    \"sales_sale_date_date\".\"D_YEAR\" as \"sales_sale_date_year\"
FROM
    \"memory\".\"web_sales\" as \"sales_web_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_web_sales_unified\".\"WS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    (2001 is not distinct from \"sales_sale_date_date\".\"D_YEAR\" or 2002 is not distinct from \"sales_sale_date_date\".\"D_YEAR\")
),
uneven as (
SELECT
    \"thoughtful\".\"sales_billing_customer_sk\" as \"sales_billing_customer_sk\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'CATALOG' and \"thoughtful\".\"sales_sale_date_year\" = 2001 THEN 2 ELSE NULL END) as \"catalog_first_year\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'CATALOG' and \"thoughtful\".\"sales_sale_date_year\" = 2002 THEN 2 ELSE NULL END) as \"catalog_second_year\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'STORE' and \"thoughtful\".\"sales_sale_date_year\" = 2001 THEN 2 ELSE NULL END) as \"store_first_year\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'STORE' and \"thoughtful\".\"sales_sale_date_year\" = 2002 THEN 2 ELSE NULL END) as \"store_second_year\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'WEB' and \"thoughtful\".\"sales_sale_date_year\" = 2001 THEN 2 ELSE NULL END) as \"web_first_year\",
    sum((( ( \"thoughtful\".\"sales_ext_list_price\" - \"thoughtful\".\"sales_ext_wholesale_cost\" ) - \"thoughtful\".\"sales_ext_discount_amount\" ) + \"thoughtful\".\"sales_ext_sales_price\") / CASE WHEN \"thoughtful\".\"sales_channel\" = 'WEB' and \"thoughtful\".\"sales_sale_date_year\" = 2002 THEN 2 ELSE NULL END) as \"web_second_year\"
FROM
    \"thoughtful\"
GROUP BY
    1
HAVING
    \"store_first_year\" > 0 and \"catalog_first_year\" > 0
),
questionable as (
SELECT
    \"sales_billing_customer_customers\".\"C_CUSTOMER_ID\" as \"sales_billing_customer_id\",
    \"sales_billing_customer_customers\".\"C_FIRST_NAME\" as \"sales_billing_customer_first_name\",
    \"sales_billing_customer_customers\".\"C_LAST_NAME\" as \"sales_billing_customer_last_name\",
    \"sales_billing_customer_customers\".\"C_PREFERRED_CUST_FLAG\" as \"sales_billing_customer_preferred_cust_flag\",
    \"uneven\".\"catalog_first_year\" as \"catalog_first_year\",
    \"uneven\".\"catalog_second_year\" as \"catalog_second_year\",
    \"uneven\".\"store_first_year\" as \"store_first_year\",
    \"uneven\".\"store_second_year\" as \"store_second_year\",
    \"uneven\".\"web_first_year\" as \"web_first_year\",
    \"uneven\".\"web_second_year\" as \"web_second_year\"
FROM
    \"uneven\"
    LEFT OUTER JOIN \"memory\".\"customer\" as \"sales_billing_customer_customers\" on \"uneven\".\"sales_billing_customer_sk\" = \"sales_billing_customer_customers\".\"C_CUSTOMER_SK\"),
vacuous as (
SELECT
    \"questionable\".\"catalog_first_year\" as \"catalog_first_year\",
    \"questionable\".\"catalog_second_year\" as \"catalog_second_year\",
    \"questionable\".\"sales_billing_customer_first_name\" as \"sales_billing_customer_first_name\",
    \"questionable\".\"sales_billing_customer_id\" as \"sales_billing_customer_id\",
    \"questionable\".\"sales_billing_customer_last_name\" as \"sales_billing_customer_last_name\",
    \"questionable\".\"sales_billing_customer_preferred_cust_flag\" as \"sales_billing_customer_preferred_cust_flag\",
    \"questionable\".\"store_first_year\" as \"store_first_year\",
    \"questionable\".\"store_second_year\" as \"store_second_year\",
    \"questionable\".\"web_first_year\" as \"web_first_year\",
    \"questionable\".\"web_second_year\" as \"web_second_year\"
FROM
    \"questionable\"
WHERE
    \"questionable\".\"catalog_first_year\" > 0
)
SELECT
    \"vacuous\".\"sales_billing_customer_id\" as \"customer_id\",
    \"vacuous\".\"sales_billing_customer_first_name\" as \"customer_first_name\",
    \"vacuous\".\"sales_billing_customer_last_name\" as \"customer_last_name\",
    \"vacuous\".\"sales_billing_customer_preferred_cust_flag\" as \"customer_preferred_cust_flag\"
FROM
    \"vacuous\"
WHERE
    \"vacuous\".\"catalog_first_year\" > 0 and \"vacuous\".\"web_first_year\" > 0 and ( CASE
	WHEN \"vacuous\".\"catalog_first_year\" > 0 THEN \"vacuous\".\"catalog_second_year\" / \"vacuous\".\"catalog_first_year\"
	ELSE null
	END ) > ( CASE
	WHEN \"vacuous\".\"store_first_year\" > 0 THEN \"vacuous\".\"store_second_year\" / \"vacuous\".\"store_first_year\"
	ELSE null
	END ) and ( CASE
	WHEN \"vacuous\".\"catalog_first_year\" > 0 THEN \"vacuous\".\"catalog_second_year\" / \"vacuous\".\"catalog_first_year\"
	ELSE null
	END ) > ( CASE
	WHEN \"vacuous\".\"web_first_year\" > 0 THEN \"vacuous\".\"web_second_year\" / \"vacuous\".\"web_first_year\"
	ELSE null
	END )

ORDER BY 
    \"customer_id\" asc nulls first,
    \"customer_first_name\" asc nulls first,
    \"customer_last_name\" asc nulls first,
    \"customer_preferred_cust_flag\" asc nulls first
LIMIT (100)"""
