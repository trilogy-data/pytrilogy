# Time-of-day dimension.

key sk int; # surrogate key (= seconds since midnight)

properties sk (
    id string, # business identifier
    time int, # Seconds since midnight (0-86399).
    hour int,
    minute int,
    --second int, # Second within the minute (0-59).
    meal_time enum<string>['', 'breakfast', 'lunch', 'dinner']?, # Empty string for off-meal hours.
);

datasource time (
    T_TIME_SK: sk,
    T_TIME_ID: id,
    T_TIME: time,
    T_HOUR: hour,
    T_MINUTE: minute,
    T_SECOND: second,
    T_MEAL_TIME: meal_time,
)
grain (sk)
address memory.time_dim;
