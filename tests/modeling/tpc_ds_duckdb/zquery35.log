    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" is not null and \"sales_sale_date_date\".\"D_YEAR\" = 2002 and \"sales_sale_date_date\".\"D_QOY\" < 4 and  'STORE'  = 'STORE'

GROUP BY
    1),
thoughtful as (
