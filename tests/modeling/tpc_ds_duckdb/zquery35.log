generated_sql = """

WITH 
macho as (
SELECT
    \"sales_web_sales_unified\".\"WS_BILL_CUSTOMER_SK\" as \"web_buyers_web_cust_id\"
FROM
    \"memory\".\"web_sales\" as \"sales_web_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_web_sales_unified\".\"WS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"sales_web_sales_unified\".\"WS_BILL_CUSTOMER_SK\" is not null and \"sales_sale_date_date\".\"D_YEAR\" = 2002 and \"sales_sale_date_date\".\"D_QOY\" < 4 and  'WEB'  = 'WEB'

GROUP BY
    1),
vacuous as (
SELECT
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" as \"store_buyers_store_cust_id\"
FROM
    \"memory\".\"store_sales\" as \"sales_store_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_store_sales_unified\".\"SS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" is not null and \"sales_sale_date_date\".\"D_YEAR\" = 2002 and \"sales_sale_date_date\".\"D_QOY\" < 4 and  'STORE'  = 'STORE'

GROUP BY
    1),
cheerful as (
SELECT
    \"sales_catalog_sales_unified\".\"CS_SHIP_CUSTOMER_SK\" as \"catalog_buyers_cat_cust_id\"
FROM
    \"memory\".\"catalog_sales\" as \"sales_catalog_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_catalog_sales_unified\".\"CS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"sales_catalog_sales_unified\".\"CS_SHIP_CUSTOMER_SK\" is not null and \"sales_sale_date_date\".\"D_YEAR\" = 2002 and \"sales_sale_date_date\".\"D_QOY\" < 4 and  'CATALOG'  = 'CATALOG'

GROUP BY
    1),
protective as (
SELECT
    \"customer_current_address_customer_address\".\"CA_STATE\" as \"customer_current_address_state\",
    \"customer_current_demographics_customer_demographics\".\"CD_DEP_COLLEGE_COUNT\" as \"customer_current_demographics_college_dependent_count\",
    \"customer_current_demographics_customer_demographics\".\"CD_DEP_COUNT\" as \"customer_current_demographics_dependent_count\",
    \"customer_current_demographics_customer_demographics\".\"CD_DEP_EMPLOYED_COUNT\" as \"customer_current_demographics_employed_dependent_count\",
    \"customer_current_demographics_customer_demographics\".\"CD_GENDER\" as \"customer_current_demographics_gender\",
    \"customer_current_demographics_customer_demographics\".\"CD_MARITAL_STATUS\" as \"customer_current_demographics_marital_status\",
    \"customer_customers\".\"C_CURRENT_CDEMO_SK\" as \"customer_current_demographics_sk\",
    \"customer_customers\".\"C_CUSTOMER_SK\" as \"customer_sk\"
FROM
    \"memory\".\"customer\" as \"customer_customers\"
    INNER JOIN \"memory\".\"customer_address\" as \"customer_current_address_customer_address\" on \"customer_customers\".\"C_CURRENT_ADDR_SK\" = \"customer_current_address_customer_address\".\"CA_ADDRESS_SK\"
    INNER JOIN \"memory\".\"customer_demographics\" as \"customer_current_demographics_customer_demographics\" on \"customer_customers\".\"C_CURRENT_CDEMO_SK\" = \"customer_current_demographics_customer_demographics\".\"CD_DEMO_SK\"
WHERE
    \"customer_customers\".\"C_CURRENT_CDEMO_SK\" is not null and exists (select 1 from vacuous where vacuous.\"store_buyers_store_cust_id\" is not distinct from \"customer_customers\".\"C_CUSTOMER_SK\") and ( exists (select 1 from macho where macho.\"web_buyers_web_cust_id\" is not distinct from \"customer_customers\".\"C_CUSTOMER_SK\") or exists (select 1 from cheerful where cheerful.\"catalog_buyers_cat_cust_id\" is not distinct from \"customer_customers\".\"C_CUSTOMER_SK\") )
),
puzzled as (
SELECT
    \"protective\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"protective\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    \"protective\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
    \"protective\".\"customer_current_demographics_employed_dependent_count\" as \"customer_current_demographics_employed_dependent_count\",
    \"protective\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"protective\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\"
FROM
    \"protective\"
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6,
    \"protective\".\"customer_current_demographics_sk\"),
waggish as (
SELECT
    \"puzzled\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"puzzled\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    \"puzzled\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
    \"puzzled\".\"customer_current_demographics_employed_dependent_count\" as \"customer_current_demographics_employed_dependent_count\",
    \"puzzled\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"puzzled\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\",
    avg(\"puzzled\".\"customer_current_demographics_college_dependent_count\") as \"avg3\",
    avg(\"puzzled\".\"customer_current_demographics_dependent_count\") as \"avg1\",
    avg(\"puzzled\".\"customer_current_demographics_employed_dependent_count\") as \"avg2\",
    max(\"puzzled\".\"customer_current_demographics_college_dependent_count\") as \"max3\",
    max(\"puzzled\".\"customer_current_demographics_dependent_count\") as \"max1\",
    max(\"puzzled\".\"customer_current_demographics_employed_dependent_count\") as \"max2\",
    min(\"puzzled\".\"customer_current_demographics_college_dependent_count\") as \"min3\",
    min(\"puzzled\".\"customer_current_demographics_dependent_count\") as \"min1\",
    min(\"puzzled\".\"customer_current_demographics_employed_dependent_count\") as \"min2\"
FROM
    \"puzzled\"
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6),
premium as (
SELECT
    \"protective\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"protective\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    \"protective\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
    \"protective\".\"customer_current_demographics_employed_dependent_count\" as \"customer_current_demographics_employed_dependent_count\",
    \"protective\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"protective\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\",
    count(\"protective\".\"customer_sk\") as \"cnt1\",
    count(\"protective\".\"customer_sk\") as \"cnt2\",
    count(\"protective\".\"customer_sk\") as \"cnt3\"
FROM
    \"protective\"
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6)
SELECT
    \"premium\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"premium\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"premium\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\",
    \"premium\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
    coalesce(\"premium\".\"cnt1\",0) as \"cnt1\",
    \"waggish\".\"min1\" as \"min1\",
    \"waggish\".\"max1\" as \"max1\",
    \"waggish\".\"avg1\" as \"avg1\",
    \"premium\".\"customer_current_demographics_employed_dependent_count\" as \"customer_current_demographics_employed_dependent_count\",
    coalesce(\"premium\".\"cnt2\",0) as \"cnt2\",
    \"waggish\".\"min2\" as \"min2\",
    \"waggish\".\"max2\" as \"max2\",
    \"waggish\".\"avg2\" as \"avg2\",
    \"premium\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    coalesce(\"premium\".\"cnt3\",0) as \"cnt3\",
    \"waggish\".\"min3\" as \"min3\",
    \"waggish\".\"max3\" as \"max3\",
    \"waggish\".\"avg3\" as \"avg3\"
FROM
    \"waggish\"
    INNER JOIN \"premium\" on \"waggish\".\"customer_current_address_state\" is not distinct from \"premium\".\"customer_current_address_state\" AND \"waggish\".\"customer_current_demographics_college_dependent_count\" is not distinct from \"premium\".\"customer_current_demographics_college_dependent_count\" AND \"waggish\".\"customer_current_demographics_dependent_count\" is not distinct from \"premium\".\"customer_current_demographics_dependent_count\" AND \"waggish\".\"customer_current_demographics_employed_dependent_count\" is not distinct from \"premium\".\"customer_current_demographics_employed_dependent_count\" AND \"waggish\".\"customer_current_demographics_gender\" is not distinct from \"premium\".\"customer_current_demographics_gender\" AND \"waggish\".\"customer_current_demographics_marital_status\" is not distinct from \"premium\".\"customer_current_demographics_marital_status\"
ORDER BY 
    \"premium\".\"customer_current_address_state\" asc nulls first,
    \"premium\".\"customer_current_demographics_gender\" asc nulls first,
    \"premium\".\"customer_current_demographics_marital_status\" asc nulls first,
    \"premium\".\"customer_current_demographics_dependent_count\" asc nulls first,
    \"premium\".\"customer_current_demographics_employed_dependent_count\" asc nulls first,
    \"premium\".\"customer_current_demographics_college_dependent_count\" asc nulls first
LIMIT (100)"""
