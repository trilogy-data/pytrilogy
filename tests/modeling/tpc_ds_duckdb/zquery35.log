    \"cheerful\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"cheerful\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    \"cheerful\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
