    \"cheerful\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"cheerful\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\",
    avg(\"cheerful\".\"customer_current_demographics_college_dependent_count\") as \"avg3\",
    avg(\"cheerful\".\"customer_current_demographics_dependent_count\") as \"avg1\",
    avg(\"cheerful\".\"customer_current_demographics_employed_dependent_count\") as \"avg2\",
    max(\"cheerful\".\"customer_current_demographics_college_dependent_count\") as \"max3\",
    max(\"cheerful\".\"customer_current_demographics_dependent_count\") as \"max1\",
    max(\"cheerful\".\"customer_current_demographics_employed_dependent_count\") as \"max2\",
    min(\"cheerful\".\"customer_current_demographics_college_dependent_count\") as \"min3\",
