    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_catalog_sales_unified\".\"CS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"sales_catalog_sales_unified\".\"CS_SHIP_CUSTOMER_SK\" is not null and \"sales_sale_date_date\".\"D_YEAR\" = 2002 and \"sales_sale_date_date\".\"D_QOY\" < 4 and  'CATALOG'  = 'CATALOG'

GROUP BY
