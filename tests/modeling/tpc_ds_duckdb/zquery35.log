    \"cheerful\"
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6)
SELECT
    \"protective\".\"customer_current_address_state\" as \"customer_current_address_state\",
    \"protective\".\"customer_current_demographics_gender\" as \"customer_current_demographics_gender\",
    \"protective\".\"customer_current_demographics_marital_status\" as \"customer_current_demographics_marital_status\",
    \"protective\".\"customer_current_demographics_dependent_count\" as \"customer_current_demographics_dependent_count\",
    \"premium\".\"cnt1\" as \"cnt1\",
    \"protective\".\"min1\" as \"min1\",
    \"protective\".\"max1\" as \"max1\",
    \"protective\".\"avg1\" as \"avg1\",
    \"protective\".\"customer_current_demographics_employed_dependent_count\" as \"customer_current_demographics_employed_dependent_count\",
    \"premium\".\"cnt2\" as \"cnt2\",
    \"protective\".\"min2\" as \"min2\",
    \"protective\".\"max2\" as \"max2\",
    \"protective\".\"avg2\" as \"avg2\",
    \"protective\".\"customer_current_demographics_college_dependent_count\" as \"customer_current_demographics_college_dependent_count\",
    \"premium\".\"cnt3\" as \"cnt3\",
    \"protective\".\"min3\" as \"min3\",
    \"protective\".\"max3\" as \"max3\",
    \"protective\".\"avg3\" as \"avg3\"
FROM
    \"premium\"
    INNER JOIN \"protective\" on \"premium\".\"customer_current_address_state\" is not distinct from \"protective\".\"customer_current_address_state\" AND \"premium\".\"customer_current_demographics_college_dependent_count\" is not distinct from \"protective\".\"customer_current_demographics_college_dependent_count\" AND \"premium\".\"customer_current_demographics_dependent_count\" is not distinct from \"protective\".\"customer_current_demographics_dependent_count\" AND \"premium\".\"customer_current_demographics_employed_dependent_count\" is not distinct from \"protective\".\"customer_current_demographics_employed_dependent_count\" AND \"premium\".\"customer_current_demographics_gender\" is not distinct from \"protective\".\"customer_current_demographics_gender\" AND \"premium\".\"customer_current_demographics_marital_status\" is not distinct from \"protective\".\"customer_current_demographics_marital_status\"
ORDER BY 
    \"protective\".\"customer_current_address_state\" asc nulls first,
    \"protective\".\"customer_current_demographics_gender\" asc nulls first,
    \"protective\".\"customer_current_demographics_marital_status\" asc nulls first,
    \"protective\".\"customer_current_demographics_dependent_count\" asc nulls first,
    \"protective\".\"customer_current_demographics_employed_dependent_count\" asc nulls first,
