generated_sql = """

WITH 
wakeful as (
SELECT
    \"customer_current_address_customer_address\".\"CA_ADDRESS_SK\" as \"customer_current_address_sk\",
    \"customer_current_address_customer_address\".\"CA_ZIP\" as \"customer_current_address_zip\",
    \"customer_customers\".\"C_CUSTOMER_SK\" as \"customer_sk\",
    \"customer_customers\".\"C_PREFERRED_CUST_FLAG\" as \"customer_preferred_cust_flag\"
FROM
    \"memory\".\"customer\" as \"customer_customers\"
    INNER JOIN \"memory\".\"customer_address\" as \"customer_current_address_customer_address\" on \"customer_customers\".\"C_CURRENT_ADDR_SK\" = \"customer_current_address_customer_address\".\"CA_ADDRESS_SK\"),
thoughtful as (
SELECT
    \"wakeful\".\"customer_current_address_zip\" as \"customer_current_address_zip\",
    count(CASE WHEN \"wakeful\".\"customer_preferred_cust_flag\" = 'Y' THEN \"wakeful\".\"customer_sk\" ELSE NULL END) as \"zip_p_count\"
FROM
    \"wakeful\"
GROUP BY
    1),
cheerful as (
SELECT
    \"wakeful\".\"customer_current_address_zip\" as \"customer_current_address_zip\"
FROM
    \"wakeful\"
GROUP BY
    1,
    \"wakeful\".\"customer_current_address_sk\"),
cooperative as (
SELECT
    SUBSTRING(CASE WHEN \"thoughtful\".\"zip_p_count\" > 10 THEN \"cheerful\".\"customer_current_address_zip\" ELSE NULL END,1,5) as \"_virt_func_substring_4293448550966409\"
FROM
    \"cheerful\"
    INNER JOIN \"thoughtful\" on \"cheerful\".\"customer_current_address_zip\" is not distinct from \"thoughtful\".\"customer_current_address_zip\"
GROUP BY
    1),
yummy as (
SELECT
    unnest(:_virt_7180871482901048) as \"zips_pre\"
),
juicy as (
SELECT
    SUBSTRING(cast(\"yummy\".\"zips_pre\" as string),1,5) as \"zips\"
FROM
    \"yummy\"),
vacuous as (
SELECT
    SUBSTRING(CASE WHEN exists (select 1 from cooperative where cooperative.\"_virt_func_substring_4293448550966409\" is not distinct from \"juicy\".\"zips\") THEN \"juicy\".\"zips\" ELSE NULL END,1,2) as \"final_zips\"
FROM
    \"juicy\"
GROUP BY
    1)
SELECT
    \"store_sales_store_store\".\"S_STORE_NAME\" as \"store_sales_store_name\",
    sum(\"store_sales_store_sales\".\"SS_NET_PROFIT\") as \"store_net_profit\"
FROM
    \"memory\".\"store_sales\" as \"store_sales_store_sales\"
    INNER JOIN \"memory\".\"date_dim\" as \"store_sales_sale_date_date\" on \"store_sales_store_sales\".\"SS_SOLD_DATE_SK\" = \"store_sales_sale_date_date\".\"D_DATE_SK\"
    INNER JOIN \"memory\".\"store\" as \"store_sales_store_store\" on \"store_sales_store_sales\".\"SS_STORE_SK\" = \"store_sales_store_store\".\"S_STORE_SK\"
WHERE
    \"store_sales_sale_date_date\".\"D_QOY\" = 2 and \"store_sales_sale_date_date\".\"D_YEAR\" = 1998 and exists (select 1 from vacuous where vacuous.\"final_zips\" = SUBSTRING(\"store_sales_store_store\".\"S_ZIP\",1,2))

GROUP BY
    1
ORDER BY 
    \"store_sales_store_store\".\"S_STORE_NAME\" asc
LIMIT (100)"""
