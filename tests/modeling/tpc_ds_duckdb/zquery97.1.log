generated_sql = """

WITH 
questionable as (
SELECT
    \"store_sales_store_sales\".\"SS_CUSTOMER_SK\" as \"customer_sk\",
    \"store_sales_store_sales\".\"SS_ITEM_SK\" as \"item_sk\",
    \"store_sales_store_sales\".\"SS_SOLD_DATE_SK\" as \"store_sales_sale_date_sk\"
FROM
    \"memory\".\"store_sales\" as \"store_sales_store_sales\"
GROUP BY
    1,
    2,
    3),
quizzical as (
SELECT
    \"catalog_sales_catalog_sales\".\"CS_BILL_CUSTOMER_SK\" as \"customer_sk\",
    \"catalog_sales_catalog_sales\".\"CS_ITEM_SK\" as \"item_sk\",
    \"catalog_sales_catalog_sales\".\"CS_SOLD_DATE_SK\" as \"catalog_sales_sale_date_sk\"
FROM
    \"memory\".\"catalog_sales\" as \"catalog_sales_catalog_sales\"
GROUP BY
    1,
    2,
    3),
uneven as (
SELECT
    max(CASE WHEN \"catalog_sales_sale_date_date\".\"D_MONTH_SEQ\" BETWEEN 1200 AND 1200 + 11 THEN ((cast(coalesce(\"customer_customers\".\"C_CUSTOMER_SK\",\"questionable\".\"customer_sk\",\"quizzical\".\"customer_sk\") as string) || '-') || cast(coalesce(\"item_items\".\"I_ITEM_SK\",\"questionable\".\"item_sk\",\"quizzical\".\"item_sk\") as string)) ELSE NULL END) as \"catalog_sales\",
    max(CASE WHEN \"store_sales_sale_date_date\".\"D_MONTH_SEQ\" BETWEEN 1200 AND 1200 + 11 THEN ((cast(coalesce(\"customer_customers\".\"C_CUSTOMER_SK\",\"questionable\".\"customer_sk\",\"quizzical\".\"customer_sk\") as string) || '-') || cast(coalesce(\"item_items\".\"I_ITEM_SK\",\"questionable\".\"item_sk\",\"quizzical\".\"item_sk\") as string)) ELSE NULL END) as \"store_sales\"
FROM
    \"memory\".\"item\" as \"item_items\"
    LEFT OUTER JOIN \"questionable\" on \"item_items\".\"I_ITEM_SK\" = \"questionable\".\"item_sk\"
    FULL JOIN \"quizzical\" on \"questionable\".\"customer_sk\" is not distinct from \"quizzical\".\"customer_sk\" AND coalesce(\"item_items\".\"I_ITEM_SK\", \"questionable\".\"item_sk\") = \"quizzical\".\"item_sk\"
    FULL JOIN \"memory\".\"customer\" as \"customer_customers\" on coalesce(\"questionable\".\"customer_sk\", \"quizzical\".\"customer_sk\") = \"customer_customers\".\"C_CUSTOMER_SK\"
    FULL JOIN \"memory\".\"date_dim\" as \"store_sales_sale_date_date\" on \"questionable\".\"store_sales_sale_date_sk\" = \"store_sales_sale_date_date\".\"D_DATE_SK\"
    FULL JOIN \"memory\".\"date_dim\" as \"catalog_sales_sale_date_date\" on \"quizzical\".\"catalog_sales_sale_date_sk\" = \"catalog_sales_sale_date_date\".\"D_DATE_SK\"
GROUP BY
    coalesce(\"customer_customers\".\"C_CUSTOMER_SK\",\"questionable\".\"customer_sk\",\"quizzical\".\"customer_sk\"),
    coalesce(\"item_items\".\"I_ITEM_SK\",\"questionable\".\"item_sk\",\"quizzical\".\"item_sk\"))
SELECT
    sum(CASE
	WHEN \"uneven\".\"store_sales\" is not null and \"uneven\".\"catalog_sales\" is null THEN 1
	ELSE 0
	END) as \"store_sale_count\",
    sum(CASE
	WHEN \"uneven\".\"store_sales\" is null and \"uneven\".\"catalog_sales\" is not null THEN 1
	ELSE 0
	END) as \"catalog_sale_count\",
    sum(CASE
	WHEN \"uneven\".\"store_sales\" is not null and \"uneven\".\"catalog_sales\" is not null THEN 1
	ELSE 0
	END) as \"both_sale_count\"
FROM
    \"uneven\""""
