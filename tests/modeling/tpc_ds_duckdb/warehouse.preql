# Warehouses: physical storage locations.

import std.geography;

key sk int; # surrogate key

properties sk (
    id string, # business identifier
    name string?,
    square_feet int?,
    state string::us_state_short?,
    city string?,
    county string?,
    --zip string?, # ZIP/postal code of the warehouse address.
    country string::country?,
);

datasource warehouse (
    w_warehouse_sk: sk,
    w_warehouse_id: id,
    w_warehouse_name: ?name,
    w_warehouse_sq_ft: square_feet,
    w_state: state,
    w_city: city,
    w_county: county,
    w_zip: zip,
    w_country: country,
)
grain (sk)
address memory.warehouse;
