# Customer dimension: identity, contact, and birth attributes.

import std.date;
import std.geography;

import customer_demographic as current_demographics;
import household_demographic as current_household_demographics;
import address as current_address;
import date as first_sales_date;
import date as first_shipto_date;

key sk int; # surrogate key
unique property sk.id string; # natural/business customer ID

properties sk (
    last_name string?, # Not guaranteed unique; weak for identity.
    first_name string?,
    preferred_cust_flag enum<string>['Y', 'N']?,
    birth_day int::day?,
    birth_month int::month?,
    birth_year int::year?, # 1924-1992 in this dataset.
    birth_country string::country?, # Free-form, e.g. 'UNITED STATES'.
    salutation enum<string>['Dr.', 'Miss', 'Mr.', 'Mrs.', 'Ms.', 'Sir']?,
    email_address string?,
    login string?,
    last_review_date string?, # Date-dim sk of the last review, stored as string.
);

auto full_name <- concat(salutation, ' ', first_name, ' ', last_name); # 'Salutation First Last'.
auto birth_date <- (birth_year::string || '/' || birth_month::string || '/' || birth_day::string)::date; # Derived calendar birth date; NULL if any component is NULL (uses ||, since concat() skips NULLs and would produce an uncastable string).

datasource customers (
    C_CUSTOMER_SK: sk,
    C_CUSTOMER_ID: id,
    C_LAST_NAME: last_name,
    C_FIRST_NAME: first_name,
    C_CURRENT_ADDR_SK: current_address.sk,
    C_CURRENT_CDEMO_SK: ?current_demographics.sk,
    C_CURRENT_HDEMO_SK: ?current_household_demographics.sk,
    C_FIRST_SALES_DATE_SK: ?first_sales_date.sk,
    C_FIRST_SHIPTO_DATE_SK: ?first_shipto_date.sk,
    C_PREFERRED_CUST_FLAG: preferred_cust_flag,
    C_BIRTH_COUNTRY: birth_country,
    C_SALUTATION: salutation,
    C_EMAIL_ADDRESS: email_address,
    C_BIRTH_DAY: birth_day,
    C_BIRTH_MONTH: birth_month,
    C_BIRTH_YEAR: birth_year,
    C_LOGIN: login,
    C_LAST_REVIEW_DATE_SK: last_review_date,
)
grain (sk)
address memory.customer;
