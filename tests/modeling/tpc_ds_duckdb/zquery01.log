generated_sql = """

WITH 
cheerful as (
SELECT
    \"ss_return_store_store\".\"S_STORE_SK\" as \"ss_return_store_sk\",
    \"ss_store_returns\".\"SR_CUSTOMER_SK\" as \"ss_return_customer_sk\",
    sum(\"ss_store_returns\".\"SR_RETURN_AMT\") as \"total_returns\"
FROM
    \"memory\".\"store_returns\" as \"ss_store_returns\"
    INNER JOIN \"memory\".\"date_dim\" as \"ss_return_date_date\" on \"ss_store_returns\".\"SR_RETURNED_DATE_SK\" = \"ss_return_date_date\".\"D_DATE_SK\"
    INNER JOIN \"memory\".\"store\" as \"ss_return_store_store\" on \"ss_store_returns\".\"SR_STORE_SK\" = \"ss_return_store_store\".\"S_STORE_SK\"
WHERE
    \"ss_return_store_store\".\"S_STATE\" = 'TN' and \"ss_return_date_date\".\"D_YEAR\" = 2000

GROUP BY
    1,
    2),
cooperative as (
SELECT
    \"cheerful\".\"ss_return_store_sk\" as \"ss_return_store_sk\",
    avg(\"cheerful\".\"total_returns\") as \"avg_store_returns\"
FROM
    \"cheerful\"
GROUP BY
    1)
SELECT
    \"ss_return_customer_customers\".\"C_CUSTOMER_ID\" as \"ss_return_customer_id\"
FROM
    \"cheerful\"
    INNER JOIN \"cooperative\" on \"cheerful\".\"ss_return_store_sk\" is not distinct from \"cooperative\".\"ss_return_store_sk\"
    LEFT OUTER JOIN \"memory\".\"customer\" as \"ss_return_customer_customers\" on \"cheerful\".\"ss_return_customer_sk\" = \"ss_return_customer_customers\".\"C_CUSTOMER_SK\"
WHERE
    \"cheerful\".\"total_returns\" > ( 1.2 * \"cooperative\".\"avg_store_returns\" )

ORDER BY 
    \"ss_return_customer_customers\".\"C_CUSTOMER_ID\" asc
LIMIT (100)"""
