generated_sql = """

WITH 
thoughtful as (
SELECT
    \"ss_store_sales\".\"SS_ITEM_SK\" as \"ss_item_sk\",
    avg(\"ss_store_sales\".\"SS_NET_PROFIT\") as \"_virt_agg_avg_7707029941687820_wscope\"
FROM
    \"memory\".\"store_sales\" as \"ss_store_sales\"
WHERE
    \"ss_store_sales\".\"SS_STORE_SK\" = 1

GROUP BY
    1),
highfalutin as (
SELECT
    avg(\"ss_store_sales\".\"SS_NET_PROFIT\") as \"addr_null_threshold_threshold\"
FROM
    \"memory\".\"store_sales\" as \"ss_store_sales\"
WHERE
    \"ss_store_sales\".\"SS_STORE_SK\" = 1 and \"ss_store_sales\".\"SS_ADDR_SK\" is null

HAVING
    count(*) > 0
),
questionable as (
SELECT
    \"ss_store_sales\".\"SS_ITEM_SK\" as \"ss_item_sk\",
    avg(\"ss_store_sales\".\"SS_NET_PROFIT\") as \"item_avg_profit\"
FROM
    \"memory\".\"store_sales\" as \"ss_store_sales\"
    INNER JOIN \"thoughtful\" on \"ss_store_sales\".\"SS_ITEM_SK\" = \"thoughtful\".\"ss_item_sk\"
    INNER JOIN \"highfalutin\" on 1=1
WHERE
    \"thoughtful\".\"_virt_agg_avg_7707029941687820_wscope\" > 0.9 * \"highfalutin\".\"addr_null_threshold_threshold\" and \"ss_store_sales\".\"SS_STORE_SK\" = 1

GROUP BY
    1),
yummy as (
SELECT
    \"questionable\".\"ss_item_sk\" as \"ss_item_sk\",
    rank() over (order by \"questionable\".\"item_avg_profit\" asc ) as \"_ascending_rnk_a\",
    rank() over (order by \"questionable\".\"item_avg_profit\" desc ) as \"_descending_rnk_d\"
FROM
    \"questionable\"),
abhorrent as (
SELECT
    \"ss_item_items\".\"I_PRODUCT_NAME\" as \"descending_worst_performing\",
    \"yummy\".\"_descending_rnk_d\" as \"descending_rnk_d\"
FROM
    \"yummy\"
    INNER JOIN \"memory\".\"item\" as \"ss_item_items\" on \"yummy\".\"ss_item_sk\" = \"ss_item_items\".\"I_ITEM_SK\"
GROUP BY
    1,
    2),
concerned as (
SELECT
    \"ss_item_items\".\"I_PRODUCT_NAME\" as \"ascending_best_performing\",
    \"yummy\".\"_ascending_rnk_a\" as \"ascending_rnk_a\"
FROM
    \"yummy\"
    INNER JOIN \"memory\".\"item\" as \"ss_item_items\" on \"yummy\".\"ss_item_sk\" = \"ss_item_items\".\"I_ITEM_SK\"
GROUP BY
    1,
    2),
sparkling as (
SELECT
    \"concerned\".\"ascending_best_performing\" as \"ascending_best_performing\",
    \"concerned\".\"ascending_rnk_a\" as \"rnk\"
FROM
    \"concerned\"
WHERE
    \"concerned\".\"ascending_rnk_a\" < 11
)
SELECT
    \"abhorrent\".\"descending_rnk_d\" as \"rnk\",
    \"sparkling\".\"ascending_best_performing\" as \"ascending_best_performing\",
    \"abhorrent\".\"descending_worst_performing\" as \"descending_worst_performing\"
FROM
    \"abhorrent\"
    INNER JOIN \"sparkling\" on \"abhorrent\".\"descending_rnk_d\" = \"sparkling\".\"rnk\"
ORDER BY 
    \"abhorrent\".\"descending_rnk_d\" asc nulls first,
    \"sparkling\".\"ascending_best_performing\" desc nulls first,
    \"abhorrent\".\"descending_worst_performing\" desc nulls first
LIMIT (100)"""
