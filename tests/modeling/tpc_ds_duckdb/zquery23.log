generated_sql = """

WITH 
macho as (
SELECT
    \"sales_store_sales_unified\".\"SS_ITEM_SK\" as \"sales_item_sk\",
    count(\"sales_store_sales_unified\".\"SS_TICKET_NUMBER\") as \"ss_combo_count\"
FROM
    \"memory\".\"store_sales\" as \"sales_store_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_store_sales_unified\".\"SS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
     'STORE'  = 'STORE' and (\"sales_sale_date_date\".\"D_YEAR\" is not null and \"sales_sale_date_date\".\"D_YEAR\" in (2000,2001,2002,2003))

GROUP BY
    1,
    \"sales_sale_date_date\".\"D_DATE\"
HAVING
    count(\"sales_store_sales_unified\".\"SS_TICKET_NUMBER\") > 4
),
friendly as (
SELECT
    \"macho\".\"sales_item_sk\" as \"_frequent_items_frequent_item_id\"
FROM
    \"macho\"
GROUP BY
    1,
    \"macho\".\"ss_combo_count\"),
divergent as (
SELECT
    \"friendly\".\"_frequent_items_frequent_item_id\" as \"frequent_items_frequent_item_id\"
FROM
    \"friendly\"
GROUP BY
    1),
highfalutin as (
SELECT
     'STORE'  as \"sales_channel\",
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
    \"sales_store_sales_unified\".\"SS_QUANTITY\" as \"sales_quantity\",
    \"sales_store_sales_unified\".\"SS_SALES_PRICE\" as \"sales_sales_price\",
    \"sales_store_sales_unified\".\"SS_SOLD_DATE_SK\" as \"sales_sale_date_sk\"
FROM
    \"memory\".\"store_sales\" as \"sales_store_sales_unified\"
WHERE
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" is not null
),
questionable as (
SELECT
    \"highfalutin\".\"sales_billing_customer_sk\" as \"_best_customers_best_customer_id\",
    sum(\"highfalutin\".\"sales_quantity\" * \"highfalutin\".\"sales_sales_price\") as \"customer_total_overall\"
FROM
    \"highfalutin\"
GROUP BY
    1),
wakeful as (
SELECT
    sum(\"highfalutin\".\"sales_quantity\" * \"highfalutin\".\"sales_sales_price\") as \"customer_total_in_window\"
FROM
    \"highfalutin\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"highfalutin\".\"sales_sale_date_sk\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    \"highfalutin\".\"sales_channel\" = 'STORE' and (\"sales_sale_date_date\".\"D_YEAR\" is not null and \"sales_sale_date_date\".\"D_YEAR\" in (2000,2001,2002,2003))

GROUP BY
    \"highfalutin\".\"sales_billing_customer_sk\"),
thoughtful as (
SELECT
    max(\"wakeful\".\"customer_total_in_window\") as \"max_total_cmax\"
FROM
    \"wakeful\"
HAVING
    count(*) > 0
),
uneven as (
SELECT
    \"questionable\".\"_best_customers_best_customer_id\" as \"best_customers_best_customer_id\"
FROM
    \"questionable\"
    INNER JOIN \"thoughtful\" on 1=1
WHERE
    \"questionable\".\"customer_total_overall\" > 0.5 * \"thoughtful\".\"max_total_cmax\"
),
sweltering as (
SELECT
    \"sales_catalog_sales_unified\".\"CS_BILL_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'CATALOG'  as \"sales_channel\",
    \"sales_catalog_sales_unified\".\"CS_LIST_PRICE\" as \"sales_list_price\",
    \"sales_catalog_sales_unified\".\"CS_QUANTITY\" as \"sales_quantity\"
FROM
    \"memory\".\"catalog_sales\" as \"sales_catalog_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_catalog_sales_unified\".\"CS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    exists (select 1 from divergent where divergent.\"frequent_items_frequent_item_id\" is not distinct from \"sales_catalog_sales_unified\".\"CS_ITEM_SK\") and exists (select 1 from uneven where uneven.\"best_customers_best_customer_id\" is not distinct from \"sales_catalog_sales_unified\".\"CS_BILL_CUSTOMER_SK\") and \"sales_sale_date_date\".\"D_YEAR\" = 2000 and \"sales_sale_date_date\".\"D_MOY\" = 2

UNION ALL
SELECT
    \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'STORE'  as \"sales_channel\",
    \"sales_store_sales_unified\".\"SS_LIST_PRICE\" as \"sales_list_price\",
    \"sales_store_sales_unified\".\"SS_QUANTITY\" as \"sales_quantity\"
FROM
    \"memory\".\"store_sales\" as \"sales_store_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_store_sales_unified\".\"SS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    exists (select 1 from divergent where divergent.\"frequent_items_frequent_item_id\" is not distinct from \"sales_store_sales_unified\".\"SS_ITEM_SK\") and exists (select 1 from uneven where uneven.\"best_customers_best_customer_id\" is not distinct from \"sales_store_sales_unified\".\"SS_CUSTOMER_SK\") and \"sales_sale_date_date\".\"D_YEAR\" = 2000 and \"sales_sale_date_date\".\"D_MOY\" = 2

UNION ALL
SELECT
    \"sales_web_sales_unified\".\"WS_BILL_CUSTOMER_SK\" as \"sales_billing_customer_sk\",
     'WEB'  as \"sales_channel\",
    \"sales_web_sales_unified\".\"WS_LIST_PRICE\" as \"sales_list_price\",
    \"sales_web_sales_unified\".\"WS_QUANTITY\" as \"sales_quantity\"
FROM
    \"memory\".\"web_sales\" as \"sales_web_sales_unified\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_sale_date_date\" on \"sales_web_sales_unified\".\"WS_SOLD_DATE_SK\" = \"sales_sale_date_date\".\"D_DATE_SK\"
WHERE
    exists (select 1 from divergent where divergent.\"frequent_items_frequent_item_id\" is not distinct from \"sales_web_sales_unified\".\"WS_ITEM_SK\") and exists (select 1 from uneven where uneven.\"best_customers_best_customer_id\" is not distinct from \"sales_web_sales_unified\".\"WS_BILL_CUSTOMER_SK\") and \"sales_sale_date_date\".\"D_YEAR\" = 2000 and \"sales_sale_date_date\".\"D_MOY\" = 2
),
late as (
SELECT
    \"sales_billing_customer_customers\".\"C_FIRST_NAME\" as \"sales_billing_customer_first_name\",
    \"sales_billing_customer_customers\".\"C_LAST_NAME\" as \"sales_billing_customer_last_name\",
    \"sweltering\".\"sales_channel\" as \"sales_channel\",
    \"sweltering\".\"sales_list_price\" as \"sales_list_price\",
    \"sweltering\".\"sales_quantity\" as \"sales_quantity\"
FROM
    \"sweltering\"
    LEFT OUTER JOIN \"memory\".\"customer\" as \"sales_billing_customer_customers\" on \"sweltering\".\"sales_billing_customer_sk\" = \"sales_billing_customer_customers\".\"C_CUSTOMER_SK\")
SELECT
    \"late\".\"sales_billing_customer_last_name\" as \"c_last_name\",
    \"late\".\"sales_billing_customer_first_name\" as \"c_first_name\",
    sum(CASE WHEN (\"late\".\"sales_channel\" is not null and \"late\".\"sales_channel\" in ('WEB','CATALOG')) THEN \"late\".\"sales_quantity\" * \"late\".\"sales_list_price\" ELSE NULL END) as \"sales_total\"
FROM
    \"late\"
GROUP BY
    1,
    2
HAVING
    \"sales_total\" > 0

ORDER BY 
    \"c_last_name\" asc nulls first,
    \"c_first_name\" asc nulls first,
    \"sales_total\" asc nulls first
LIMIT (100)"""
