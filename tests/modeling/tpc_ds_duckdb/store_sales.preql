# For cross-channel questions, prefer `all_sales` (combines this with catalog_sales and web_sales).
# Store channel sales AND returns at (item, ticket_number) grain — the single model
# for all store-channel analysis, including returns-only questions. Return columns
# are NULL on lines never returned.

import std.money;

import item as item;
import date as sale_date;
import date as return_date;
import time as sale_time;
import time as return_time;
import customer as customer;
import customer as return_customer; # may differ from the purchasing customer
import promotion as promotion;
import customer_demographic as pos_customer_demographic; # buyer's demographics AS OF the sale, not their current record
import customer_demographic as return_customer_demographic; # returner's demographics AS OF the return, not their current record
import household_demographic as pos_household_demographic; # buyer's household demographics AS OF the sale, not their current record
import household_demographic as return_household_demographic; # returner's household demographics AS OF the return, not their current record
import store as store;
import store as return_store;
import address as pos_address; # customer's address AS OF the sale, not their current record
import address as return_address; # returner's address AS OF the return, not their current record
import reason as return_reason;

key ticket_number int; # receipt number identifying a single in-store transaction

properties <ticket_number, item.sk> (
    quantity int,
    sales_price numeric::usd, # Per-unit "unit price" charged; the whole-line total is ext_sales_price.
    list_price numeric::usd, # Per-unit, before discounts.
    ext_sales_price numeric(15,2)::usd, # Whole-line "total price" = sales_price x quantity; per-unit price is sales_price.
    ext_wholesale_cost numeric::usd,
    ext_list_price numeric::usd,
    ext_discount_amount numeric::usd,
    coupon_amt numeric::usd, # Coupon/credit applied to the line.
    net_profit numeric::usd, # Reported net profit. Distinct from derived `profit`; use net_profit for "net profit" questions.
    _returned_ticket int?, # Internal; NULL when not returned. Use is_returned instead.
    net_paid numeric::usd, # Excludes tax.
    ext_tax numeric::usd?,
    wholesale_cost numeric::usd, # Per-unit.
    return_amount numeric::usd?, # Refund excluding tax.
    return_quantity int?,
    return_net_loss numeric::usd?,
    return_tax numeric::usd?,
    return_amount_inc_tax numeric::usd?,
    return_fee numeric::usd?,
    return_ship_cost numeric::usd?,
    refunded_cash numeric::usd?,
    reversed_charge numeric::usd?, # Refund portion reversed on the original payment method.
    store_credit numeric::usd?,
    row_counter int, # Constant 1 per line item.
);

auto profit <- ext_list_price - ext_wholesale_cost - ext_discount_amount + ext_sales_price; # Derived line "gross value". NOT the reported net_profit column.

auto line_item <- concat(ticket_number::string, '-', item.sk::string); # Unique line-item id. Count line items with count(line_item), NOT count(ticket_number) (dedups multi-item tickets).
auto line_item_count<- sum(row_counter); # = count(line_item); kept for queries that reference it.
auto is_returned <- _returned_ticket is not null; # True when a return row exists for this line, else False.

datasource store_sales (
    raw('''1'''): row_counter,
    SS_SOLD_DATE_SK: ?sale_date.sk, # FK to date the sale occurred (optional in source data).
    SS_SOLD_TIME_SK: ?sale_time.sk, # FK to time-of-day the sale occurred.
    SS_CUSTOMER_SK: ?customer.sk, # FK to the purchasing customer (optional — anonymous sales allowed).
    SS_CDEMO_SK: ?pos_customer_demographic.sk, # FK to the customer's demographic profile at time of sale.
    SS_HDEMO_SK: ?pos_household_demographic.sk, # FK to the customer's household profile at time of sale.
    SS_TICKET_NUMBER: ticket_number,
    SS_ITEM_SK: item.sk, # FK to the item sold.
    SS_SALES_PRICE: sales_price,
    SS_LIST_PRICE: list_price,
    SS_EXT_SALES_PRICE: ext_sales_price,
    SS_EXT_LIST_PRICE: ext_list_price,
    SS_EXT_WHOLESALE_COST: ext_wholesale_cost,
    SS_EXT_DISCOUNT_AMT: ext_discount_amount,
    SS_NET_PROFIT: net_profit,
    SS_PROMO_SK: ?promotion.sk, # FK to the promotion applied to the line, if any.
    SS_QUANTITY: quantity,
    SS_COUPON_AMT: coupon_amt,
    SS_STORE_SK: ?store.sk, # FK to the store the sale occurred at.
    SS_NET_PAID: net_paid,
    SS_EXT_TAX: ext_tax,
    SS_WHOLESALE_COST: wholesale_cost,
    SS_ADDR_SK: ?pos_address.sk, # FK to the customer's address at time of sale.
)
grain (item.sk, ticket_number)
address memory.store_sales;

datasource store_returns (
    SR_RETURNED_DATE_SK: return_date.sk, # FK to date the return occurred.
    SR_RETURN_TIME_SK: return_time.sk, # FK to time-of-day the return was processed.
    SR_ITEM_SK: ~item.sk,
    SR_CUSTOMER_SK: ?return_customer.sk, # FK to the customer returning the item (may differ from purchaser); nullable — some returns record no customer.
    SR_CDEMO_SK: ?return_customer_demographic.sk, # FK to the returning customer's demographic profile at return time.
    SR_HDEMO_SK: ?return_household_demographic.sk, # FK to the returning customer's household profile at return time.
    SR_ADDR_SK: ?return_address.sk, # FK to the returning customer's address at return time.
    SR_RETURN_AMT: return_amount,
    SR_RETURN_QUANTITY: return_quantity,
    SR_RETURN_TAX: return_tax,
    SR_RETURN_AMT_INC_TAX: return_amount_inc_tax,
    SR_FEE: return_fee,
    SR_RETURN_SHIP_COST: return_ship_cost,
    SR_REFUNDED_CASH: refunded_cash,
    SR_REVERSED_CHARGE: reversed_charge,
    SR_STORE_CREDIT: store_credit,
    SR_TICKET_NUMBER: ~ticket_number,
    SR_STORE_SK: ?return_store.sk, # FK to the store the return was processed at; nullable — some returns record no store.
    SR_REASON_SK: return_reason.sk, # FK to the return-reason code.
    SR_NET_LOSS: return_net_loss,
    SR_TICKET_NUMBER: _returned_ticket,
)
grain (item.sk, ticket_number)
address memory.store_returns;
