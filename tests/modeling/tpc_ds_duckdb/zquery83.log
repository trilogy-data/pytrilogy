generated_sql = """

WITH 
cooperative as (
SELECT
     'CATALOG'  as \"sales_channel\",
    \"sales_catalog_returns_unified\".\"CR_ITEM_SK\" as \"sales_item_sk\",
    \"sales_catalog_returns_unified\".\"CR_ORDER_NUMBER\" as \"sales_order_id\",
    \"sales_catalog_returns_unified\".\"CR_RETURNED_DATE_SK\" as \"sales_return_date_sk\",
    \"sales_catalog_returns_unified\".\"CR_RETURN_QUANTITY\" as \"sales_return_quantity\"
FROM
    \"memory\".\"catalog_returns\" as \"sales_catalog_returns_unified\"
UNION ALL
SELECT
     'STORE'  as \"sales_channel\",
    \"sales_store_returns_unified\".\"SR_ITEM_SK\" as \"sales_item_sk\",
    \"sales_store_returns_unified\".\"SR_TICKET_NUMBER\" as \"sales_order_id\",
    \"sales_store_returns_unified\".\"SR_RETURNED_DATE_SK\" as \"sales_return_date_sk\",
    \"sales_store_returns_unified\".\"SR_RETURN_QUANTITY\" as \"sales_return_quantity\"
FROM
    \"memory\".\"store_returns\" as \"sales_store_returns_unified\"
UNION ALL
SELECT
     'WEB'  as \"sales_channel\",
    \"sales_web_returns_unified\".\"WR_ITEM_SK\" as \"sales_item_sk\",
    \"sales_web_returns_unified\".\"WR_ORDER_NUMBER\" as \"sales_order_id\",
    \"sales_web_returns_unified\".\"WR_RETURNED_DATE_SK\" as \"sales_return_date_sk\",
    \"sales_web_returns_unified\".\"WR_RETURN_QUANTITY\" as \"sales_return_quantity\"
FROM
    \"memory\".\"web_returns\" as \"sales_web_returns_unified\"),
quizzical as (
SELECT
    \"date_date\".\"D_WEEK_SEQ\" as \"target_week_seqs\"
FROM
    \"memory\".\"date_dim\" as \"date_date\"
WHERE
    (date '2000-06-30' is not distinct from cast(\"date_date\".\"D_DATE\" as date) or date '2000-09-27' is not distinct from cast(\"date_date\".\"D_DATE\" as date) or date '2000-11-17' is not distinct from cast(\"date_date\".\"D_DATE\" as date))

GROUP BY
    1),
uneven as (
SELECT
    \"cooperative\".\"sales_channel\" as \"sales_channel\",
    \"cooperative\".\"sales_order_id\" as \"sales_order_id\",
    \"cooperative\".\"sales_return_quantity\" as \"sales_return_quantity\",
    \"sales_item_items\".\"I_ITEM_ID\" as \"sales_item_id\"
FROM
    \"cooperative\"
    INNER JOIN \"memory\".\"item\" as \"sales_item_items\" on \"cooperative\".\"sales_item_sk\" = \"sales_item_items\".\"I_ITEM_SK\"
    INNER JOIN \"memory\".\"date_dim\" as \"sales_return_date_date\" on \"cooperative\".\"sales_return_date_sk\" = \"sales_return_date_date\".\"D_DATE_SK\"
WHERE
    exists (select 1 from quizzical where quizzical.\"target_week_seqs\" is not distinct from \"sales_return_date_date\".\"D_WEEK_SEQ\")
)
SELECT
    \"uneven\".\"sales_item_id\" as \"item_id\",
    sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) as \"sr_item_qty\",
    ( ( (sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) * 1.0) / ( ( sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) ) / 3.0 ) * 100 as \"sr_dev\",
    sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) as \"cr_item_qty\",
    ( ( (sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) * 1.0) / ( ( sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) ) / 3.0 ) * 100 as \"cr_dev\",
    sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) as \"wr_item_qty\",
    ( ( (sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) * 1.0) / ( ( sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) ) / 3.0 ) * 100 as \"wr_dev\",
    ( ( sum(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) + sum(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_return_quantity\" ELSE NULL END) ) / 3.0 as \"average\"
FROM
    \"uneven\"
GROUP BY
    1
HAVING
    count(CASE WHEN \"uneven\".\"sales_channel\" = 'STORE' THEN \"uneven\".\"sales_order_id\" ELSE NULL END) > 0 and count(CASE WHEN \"uneven\".\"sales_channel\" = 'CATALOG' THEN \"uneven\".\"sales_order_id\" ELSE NULL END) > 0 and count(CASE WHEN \"uneven\".\"sales_channel\" = 'WEB' THEN \"uneven\".\"sales_order_id\" ELSE NULL END) > 0

ORDER BY 
    \"item_id\" asc nulls first,
    \"sr_item_qty\" asc nulls first
LIMIT (100)"""
