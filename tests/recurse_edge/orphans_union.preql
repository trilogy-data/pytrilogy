self import as app;

key pid int;
property pid.app_parent int?;
property pid.name string;
property pid.mem int;
auto app_pid <- recurse_edge(pid, app_parent);
# orphan walks end at an exited parent (99, 98) that is no process's pid, and
# most pids launch nothing: the two key sets overlap, neither contains the other
merge union app_pid = app.pid;

datasource procs (pid: pid, app_parent: app_parent, name: name, mem: mem)
grain (pid)
query '''
select * from (values (1, null, 'code', 10), (2, 1, 'node', 5), (6, 99, 'orphan', 100),
    (7, 6, 'kid', 1000), (8, 7, 'gkid', 10000), (9, 98, 'lone', 3)) as t(pid, app_parent, name, mem)
''';
