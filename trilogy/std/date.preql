

type year int;
type decade int;
type century int;
type month int[1..12];
type month_name string;
type quarter int[1..4];
type week int[1..53];
type day int[1..31];
# hour/minute/second stay unbounded: they double as duration-unit tags
# (e.g. `duration numeric::second`), unlike the calendar-position types above.
# second is numeric so a cast keeps fractions (1.5 seconds of CPU time); the
# second(...) date part still returns an integer.
type hour int;
type minute int;
type second numeric;
type millisecond int;
# 1 on Sunday through 7 on Saturday on every dialect
type day_of_week int[1..7];
type day_of_week_name string;

