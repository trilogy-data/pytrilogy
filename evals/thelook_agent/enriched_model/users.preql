# Customer profiles. Every customer remains in this domain even when they have
# never ordered; sale facts bind the customer key partially for that reason.

# The categorical domains are declared rather than left open: a `string` mocks
# as a unique value per row, which turns every group-by into a no-op and every
# literal filter into an empty result.
key id int; # customer ID
properties id (
    state enum<string>['CA', 'NY', 'TX', 'FL', 'WA', 'IL', 'MA', 'CO', 'GA', 'NC'], # US postal state
    age int[18..78], # age in years
    traffic_source enum<string>['Search', 'Organic', 'Email', 'Facebook', 'Display'], # original acquisition channel
);

property id.age_band <- case
    when age < 25 then '18-24'
    when age < 35 then '25-34'
    when age < 45 then '35-44'
    when age < 55 then '45-54'
    when age < 65 then '55-64'
    else '65+'
end; # standard reporting age band

root datasource users (
    id,
    state,
    age,
    traffic_source,
)
grain (id)
address users;
