import store_sales as ss;
import item as item;

rowset cat_avg <-
select
    item.category as category,
    avg(item.current_price) as cat_avg_price;

select
    ss.item.brand_name,
    count(grain(ss.item.sk) ? ss.item.current_price > cat_avg.cat_avg_price) as above_avg
union join ss.item.category = cat_avg.category;
