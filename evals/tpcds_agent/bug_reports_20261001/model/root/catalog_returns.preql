# Datasource ingested from catalog_returns
# Grain: item_sk, order_number. Properties: return_quantity, return_amount, return_tax, return_amt_inc_tax, fee, return_ship_cost, refunded_cash, reversed_charge, store_credit, net_loss.
# Imports: call_center via cr_call_center_sk (fields as call_center.*), catalog_page via cr_catalog_page_sk (fields as catalog_page.*), date_dim via cr_returned_date_sk (fields as date_dim.*), item via cr_item_sk (fields as item.*), reason via cr_reason_sk (fields as reason.*), refunded_addr via cr_refunded_addr_sk (fields as refunded_addr.*), refunded_cdemo via cr_refunded_cdemo_sk (fields as refunded_cdemo.*), refunded_customer via cr_refunded_customer_sk (fields as refunded_customer.*), refunded_hdemo via cr_refunded_hdemo_sk (fields as refunded_hdemo.*), returning_addr via cr_returning_addr_sk (fields as returning_addr.*), returning_cdemo via cr_returning_cdemo_sk (fields as returning_cdemo.*), returning_customer via cr_returning_customer_sk (fields as returning_customer.*), returning_hdemo via cr_returning_hdemo_sk (fields as returning_hdemo.*), ship_mode via cr_ship_mode_sk (fields as ship_mode.*), time_dim via cr_returned_time_sk (fields as time_dim.*), warehouse via cr_warehouse_sk (fields as warehouse.*).
import call_center as call_center;
import catalog_page as catalog_page;
import customer as refunded_customer;
import customer as returning_customer;
import customer_address as refunded_addr;
import customer_address as returning_addr;
import customer_demographics as refunded_cdemo;
import customer_demographics as returning_cdemo;
import date_dim as date_dim;
import household_demographics as refunded_hdemo;
import household_demographics as returning_hdemo;
import item as item;
import reason as reason;
import ship_mode as ship_mode;
import time_dim as time_dim;
import warehouse as warehouse;

key order_number bigint;

properties <order_number, item.item_sk> (
    return_quantity bigint[1..100]?,
    return_amount numeric[0..]?,
    return_tax numeric[0..]?,
    return_amt_inc_tax numeric[0..]?,
    fee numeric[0..]?,
    return_ship_cost numeric[0..]?,
    refunded_cash numeric[0..]?,
    reversed_charge numeric[0..]?,
    store_credit numeric[0..]?,
    net_loss numeric[0..]?,
);

root datasource catalog_returns (
    cr_returned_date_sk: ~date_dim.date_sk,
    cr_returned_time_sk: ~time_dim.time_sk,
    cr_item_sk: ~item.item_sk,
    cr_refunded_customer_sk: ~?refunded_customer.customer_sk,
    cr_refunded_cdemo_sk: ~?refunded_cdemo.demo_sk,
    cr_refunded_hdemo_sk: ?refunded_hdemo.demo_sk,
    cr_refunded_addr_sk: ~?refunded_addr.address_sk,
    cr_returning_customer_sk: ~?returning_customer.customer_sk,
    cr_returning_cdemo_sk: ~?returning_cdemo.demo_sk,
    cr_returning_hdemo_sk: ?returning_hdemo.demo_sk,
    cr_returning_addr_sk: ~?returning_addr.address_sk,
    cr_call_center_sk: ?call_center.call_center_sk,
    cr_catalog_page_sk: ~?catalog_page.catalog_page_sk,
    cr_ship_mode_sk: ?ship_mode.ship_mode_sk,
    cr_warehouse_sk: ?warehouse.warehouse_sk,
    cr_reason_sk: ?reason.sk,
    cr_order_number: order_number,
    cr_return_quantity: ?return_quantity,
    cr_return_amount: ?return_amount,
    cr_return_tax: ?return_tax,
    cr_return_amt_inc_tax: ?return_amt_inc_tax,
    cr_fee: ?fee,
    cr_return_ship_cost: ?return_ship_cost,
    cr_refunded_cash: ?refunded_cash,
    cr_reversed_charge: ?reversed_charge,
    cr_store_credit: ?store_credit,
    cr_net_loss: ?net_loss,
)
grain (item.item_sk, order_number)
address catalog_returns;
