# Datasource ingested from catalog_sales
# Grain: item_sk, order_number. Properties: quantity, wholesale_cost, list_price, sales_price, ext_discount_amt, ext_sales_price, ext_wholesale_cost, ext_list_price, ext_tax, coupon_amt, ext_ship_cost, net_paid, +4 more.
# Imports: bill_addr via cs_bill_addr_sk (fields as bill_addr.*), bill_cdemo via cs_bill_cdemo_sk (fields as bill_cdemo.*), bill_customer via cs_bill_customer_sk (fields as bill_customer.*), bill_hdemo via cs_bill_hdemo_sk (fields as bill_hdemo.*), call_center via cs_call_center_sk (fields as call_center.*), catalog_page via cs_catalog_page_sk (fields as catalog_page.*), item via cs_item_sk (fields as item.*), promotion via cs_promo_sk (fields as promotion.*), ship_addr via cs_ship_addr_sk (fields as ship_addr.*), ship_cdemo via cs_ship_cdemo_sk (fields as ship_cdemo.*), ship_customer via cs_ship_customer_sk (fields as ship_customer.*), ship_date via cs_ship_date_sk (fields as ship_date.*), ship_hdemo via cs_ship_hdemo_sk (fields as ship_hdemo.*), ship_mode via cs_ship_mode_sk (fields as ship_mode.*), sold_date via cs_sold_date_sk (fields as sold_date.*), time_dim via cs_sold_time_sk (fields as time_dim.*), warehouse via cs_warehouse_sk (fields as warehouse.*).
import call_center as call_center;
import catalog_page as catalog_page;
import customer as bill_customer;
import customer as ship_customer;
import customer_address as bill_addr;
import customer_address as ship_addr;
import customer_demographics as bill_cdemo;
import customer_demographics as ship_cdemo;
import date_dim as ship_date;
import date_dim as sold_date;
import household_demographics as bill_hdemo;
import household_demographics as ship_hdemo;
import item as item;
import promotion as promotion;
import ship_mode as ship_mode;
import time_dim as time_dim;
import warehouse as warehouse;

key order_number bigint;

properties <order_number, item.item_sk> (
    quantity bigint[1..100]?,
    wholesale_cost numeric[0..]?,
    list_price numeric[0..]?,
    sales_price numeric[0..]?,
    ext_discount_amt numeric[0..]?,
    ext_sales_price numeric[0..]?,
    ext_wholesale_cost numeric[0..]?,
    ext_list_price numeric[0..]?,
    ext_tax numeric[0..]?,
    coupon_amt numeric[0..]?,
    ext_ship_cost numeric[0..]?,
    net_paid numeric[0..]?,
    net_paid_inc_tax numeric[0..]?,
    net_paid_inc_ship numeric[0..],
    net_paid_inc_ship_tax numeric[0..],
    net_profit numeric,
);

root datasource catalog_sales (
    cs_sold_date_sk: ~?sold_date.date_sk,
    cs_sold_time_sk: ~?time_dim.time_sk,
    cs_ship_date_sk: ~?ship_date.date_sk,
    cs_bill_customer_sk: ~?bill_customer.customer_sk,
    cs_bill_cdemo_sk: ~?bill_cdemo.demo_sk,
    cs_bill_hdemo_sk: ?bill_hdemo.demo_sk,
    cs_bill_addr_sk: ~?bill_addr.address_sk,
    cs_ship_customer_sk: ~?ship_customer.customer_sk,
    cs_ship_cdemo_sk: ~?ship_cdemo.demo_sk,
    cs_ship_hdemo_sk: ?ship_hdemo.demo_sk,
    cs_ship_addr_sk: ~?ship_addr.address_sk,
    cs_call_center_sk: ?call_center.call_center_sk,
    cs_catalog_page_sk: ~?catalog_page.catalog_page_sk,
    cs_ship_mode_sk: ?ship_mode.ship_mode_sk,
    cs_warehouse_sk: ?warehouse.warehouse_sk,
    cs_item_sk: item.item_sk,
    cs_promo_sk: ?promotion.promo_sk,
    cs_order_number: order_number,
    cs_quantity: ?quantity,
    cs_wholesale_cost: ?wholesale_cost,
    cs_list_price: ?list_price,
    cs_sales_price: ?sales_price,
    cs_ext_discount_amt: ?ext_discount_amt,
    cs_ext_sales_price: ?ext_sales_price,
    cs_ext_wholesale_cost: ?ext_wholesale_cost,
    cs_ext_list_price: ?ext_list_price,
    cs_ext_tax: ?ext_tax,
    cs_coupon_amt: ?coupon_amt,
    cs_ext_ship_cost: ?ext_ship_cost,
    cs_net_paid: ?net_paid,
    cs_net_paid_inc_tax: ?net_paid_inc_tax,
    cs_net_paid_inc_ship: net_paid_inc_ship,
    cs_net_paid_inc_ship_tax: net_paid_inc_ship_tax,
    cs_net_profit: net_profit,
)
grain (item.item_sk, order_number)
address catalog_sales;
