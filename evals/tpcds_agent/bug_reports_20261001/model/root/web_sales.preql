# Datasource ingested from web_sales
# Grain: item_sk, order_number. Properties: quantity, wholesale_cost, list_price, sales_price, ext_discount_amt, ext_sales_price, ext_wholesale_cost, ext_list_price, ext_tax, coupon_amt, ext_ship_cost, net_paid, +4 more.
# Imports: bill_addr via ws_bill_addr_sk (fields as bill_addr.*), bill_cdemo via ws_bill_cdemo_sk (fields as bill_cdemo.*), bill_customer via ws_bill_customer_sk (fields as bill_customer.*), bill_hdemo via ws_bill_hdemo_sk (fields as bill_hdemo.*), item via ws_item_sk (fields as item.*), promotion via ws_promo_sk (fields as promotion.*), ship_addr via ws_ship_addr_sk (fields as ship_addr.*), ship_cdemo via ws_ship_cdemo_sk (fields as ship_cdemo.*), ship_customer via ws_ship_customer_sk (fields as ship_customer.*), ship_date via ws_ship_date_sk (fields as ship_date.*), ship_hdemo via ws_ship_hdemo_sk (fields as ship_hdemo.*), ship_mode via ws_ship_mode_sk (fields as ship_mode.*), sold_date via ws_sold_date_sk (fields as sold_date.*), time_dim via ws_sold_time_sk (fields as time_dim.*), warehouse via ws_warehouse_sk (fields as warehouse.*), web_page via ws_web_page_sk (fields as web_page.*), web_site via ws_web_site_sk (fields as web_site.*).
import customer as bill_customer;
import customer as ship_customer;
import customer_address as bill_addr;
import customer_address as ship_addr;
import customer_demographics as bill_cdemo;
import customer_demographics as ship_cdemo;
import date_dim as ship_date;
import date_dim as sold_date;
import household_demographics as bill_hdemo;
import household_demographics as ship_hdemo;
import item as item;
import promotion as promotion;
import ship_mode as ship_mode;
import time_dim as time_dim;
import warehouse as warehouse;
import web_page as web_page;
import web_site as web_site;

key order_number bigint;

properties <order_number, item.item_sk> (
    quantity bigint[1..100]?,
    wholesale_cost numeric[0..]?,
    list_price numeric[0..]?,
    sales_price numeric[0..],
    ext_discount_amt numeric[0..]?,
    ext_sales_price numeric[0..]?,
    ext_wholesale_cost numeric[0..]?,
    ext_list_price numeric[0..]?,
    ext_tax numeric[0..],
    coupon_amt numeric[0..],
    ext_ship_cost numeric[0..]?,
    net_paid numeric[0..]?,
    net_paid_inc_tax numeric[0..]?,
    net_paid_inc_ship numeric[0..],
    net_paid_inc_ship_tax numeric[0..],
    net_profit numeric,
);

root datasource web_sales (
    ws_sold_date_sk: ~?sold_date.date_sk,
    ws_sold_time_sk: ~?time_dim.time_sk,
    ws_ship_date_sk: ~?ship_date.date_sk,
    ws_item_sk: item.item_sk,
    ws_bill_customer_sk: ~?bill_customer.customer_sk,
    ws_bill_cdemo_sk: ~?bill_cdemo.demo_sk,
    ws_bill_hdemo_sk: ?bill_hdemo.demo_sk,
    ws_bill_addr_sk: ~bill_addr.address_sk,
    ws_ship_customer_sk: ~?ship_customer.customer_sk,
    ws_ship_cdemo_sk: ~?ship_cdemo.demo_sk,
    ws_ship_hdemo_sk: ?ship_hdemo.demo_sk,
    ws_ship_addr_sk: ~?ship_addr.address_sk,
    ws_web_page_sk: ?web_page.web_page_sk,
    ws_web_site_sk: web_site.site_sk,
    ws_ship_mode_sk: ?ship_mode.ship_mode_sk,
    ws_warehouse_sk: ?warehouse.warehouse_sk,
    ws_promo_sk: ?promotion.promo_sk,
    ws_order_number: order_number,
    ws_quantity: ?quantity,
    ws_wholesale_cost: ?wholesale_cost,
    ws_list_price: ?list_price,
    ws_sales_price: sales_price,
    ws_ext_discount_amt: ?ext_discount_amt,
    ws_ext_sales_price: ?ext_sales_price,
    ws_ext_wholesale_cost: ?ext_wholesale_cost,
    ws_ext_list_price: ?ext_list_price,
    ws_ext_tax: ext_tax,
    ws_coupon_amt: coupon_amt,
    ws_ext_ship_cost: ?ext_ship_cost,
    ws_net_paid: ?net_paid,
    ws_net_paid_inc_tax: ?net_paid_inc_tax,
    ws_net_paid_inc_ship: net_paid_inc_ship,
    ws_net_paid_inc_ship_tax: net_paid_inc_ship_tax,
    ws_net_profit: net_profit,
)
grain (item.item_sk, order_number)
address web_sales;
