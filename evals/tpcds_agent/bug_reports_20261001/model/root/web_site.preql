# Datasource ingested from web_site
# Grain: site_sk. Properties: site_id, rec_start_date, rec_end_date, name, class, manager, mkt_id, mkt_class, mkt_desc, market_manager, company_id, company_name, +11 more.
# Imports: close_date via web_close_date_sk (fields as close_date.*), open_date via web_open_date_sk (fields as open_date.*).
# Referenced by: web_sales.
import std.geography;
import date_dim as close_date;
import date_dim as open_date;

key site_sk bigint;

properties site_sk (
    site_id string,
    rec_start_date date,
    rec_end_date date?,
    name enum<string>['site_0', 'site_1', 'site_2', 'site_3', 'site_4'],
    class enum<string>['Unknown'],
    manager string,
    mkt_id enum<bigint>[1, 2, 3, 4, 5, 6],
    mkt_class string,
    mkt_desc string,
    market_manager string,
    company_id enum<bigint>[1, 2, 3, 4, 5, 6],
    company_name enum<string>['able', 'anti', 'cally', 'ese', 'ought', 'pri'],
    street_number string,
    street_name string,
    street_type string,
    suite_number string,
    city enum<string>['Fairview', 'Midway']::city,
    county enum<string>['Williamson County'],
    state enum<string>['TN']::us_state,
    zip enum<string>['31904', '35709']::us_zip_code,
    country enum<string>['United States']::country,
    gmt_offset numeric,
    tax_percentage numeric[0..],
);

root datasource web_site (
    web_site_sk: site_sk,
    web_site_id: site_id,
    web_rec_start_date: rec_start_date,
    web_rec_end_date: ?rec_end_date,
    web_name: name,
    web_open_date_sk: ~open_date.date_sk,
    web_close_date_sk: ~?close_date.date_sk,
    web_class: class,
    web_manager: manager,
    web_mkt_id: mkt_id,
    web_mkt_class: mkt_class,
    web_mkt_desc: mkt_desc,
    web_market_manager: market_manager,
    web_company_id: company_id,
    web_company_name: company_name,
    web_street_number: street_number,
    web_street_name: street_name,
    web_street_type: street_type,
    web_suite_number: suite_number,
    web_city: city,
    web_county: county,
    web_state: state,
    web_zip: zip,
    web_country: country,
    web_gmt_offset: gmt_offset,
    web_tax_percentage: tax_percentage,
)
grain (site_sk)
address web_site;
