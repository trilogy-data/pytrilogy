# Datasource ingested from reason
# Grain: sk. Properties: id, desc.
# Referenced by: catalog_returns, store_returns, web_returns.
key sk bigint;

properties sk (
    id string,
    desc string,
);

root datasource reason (
    r_reason_sk: sk,
    r_reason_id: id,
    r_reason_desc: desc,
)
grain (sk)
address reason;
