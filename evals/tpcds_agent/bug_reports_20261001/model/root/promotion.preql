# Datasource ingested from promotion
# Grain: promo_sk. Properties: promo_id, cost, response_target, promo_name, channel_dmail, channel_email, channel_catalog, channel_tv, channel_radio, channel_press, channel_event, channel_demo, +3 more.
# Imports: end_date via p_end_date_sk (fields as end_date.*), item via p_item_sk (fields as item.*), start_date via p_start_date_sk (fields as start_date.*).
# Referenced by: catalog_sales, store_sales, web_sales.
import date_dim as end_date;
import date_dim as start_date;
import item as item;

key promo_sk bigint;

properties promo_sk (
    promo_id string,
    cost numeric[0..]?,
    response_target enum<bigint>[1]?,
    promo_name enum<string>['able', 'anti', 'ation', 'bar', 'cally', 'eing', 'ese', 'n st', 'ought', 'pri']?,
    channel_dmail enum<string>['N', 'Y']?,
    channel_email enum<string>['N']?,
    channel_catalog enum<string>['N']?,
    channel_tv enum<string>['N']?,
    channel_radio enum<string>['N']?,
    channel_press enum<string>['N']?,
    channel_event enum<string>['N']?,
    channel_demo enum<string>['N']?,
    channel_details string?,
    purpose enum<string>['Unknown']?,
    discount_active enum<string>['N']?,
);

root datasource promotion (
    p_promo_sk: promo_sk,
    p_promo_id: promo_id,
    p_start_date_sk: ~?start_date.date_sk,
    p_end_date_sk: ~?end_date.date_sk,
    p_item_sk: ~?item.item_sk,
    p_cost: ?cost,
    p_response_target: ?response_target,
    p_promo_name: ?promo_name,
    p_channel_dmail: ?channel_dmail,
    p_channel_email: ?channel_email,
    p_channel_catalog: ?channel_catalog,
    p_channel_tv: ?channel_tv,
    p_channel_radio: ?channel_radio,
    p_channel_press: ?channel_press,
    p_channel_event: ?channel_event,
    p_channel_demo: ?channel_demo,
    p_channel_details: ?channel_details,
    p_purpose: ?purpose,
    p_discount_active: ?discount_active,
)
grain (promo_sk)
address promotion;
