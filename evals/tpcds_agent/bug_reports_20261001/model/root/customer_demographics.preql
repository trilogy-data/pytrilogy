# Datasource ingested from customer_demographics
# Grain: demo_sk. Properties: gender, marital_status, education_status, purchase_estimate, credit_rating, dep_count, dep_employed_count, dep_college_count.
# Referenced by: catalog_returns, catalog_sales, customer, store_returns, store_sales, web_returns, web_sales.
key demo_sk bigint;

properties demo_sk (
    gender enum<string>['F', 'M'],
    marital_status enum<string>['D', 'M', 'S', 'U', 'W'],
    education_status enum<string>['2 yr Degree', '4 yr Degree', 'Advanced Degree', 'College', 'Primary', 'Secondary', 'Unknown'],
    purchase_estimate bigint[500..10000],
    credit_rating enum<string>['Good', 'High Risk', 'Low Risk', 'Unknown'],
    dep_count enum<bigint>[0, 1, 2, 3, 4, 5, 6],
    dep_employed_count enum<bigint>[0, 1, 2, 3, 4, 5, 6],
    dep_college_count enum<int>[0, 1, 2, 3, 4, 5, 6],
);

root datasource customer_demographics (
    cd_demo_sk: demo_sk,
    cd_gender: gender,
    cd_marital_status: marital_status,
    cd_education_status: education_status,
    cd_purchase_estimate: purchase_estimate,
    cd_credit_rating: credit_rating,
    cd_dep_count: dep_count,
    cd_dep_employed_count: dep_employed_count,
    cd_dep_college_count: dep_college_count,
)
grain (demo_sk)
address customer_demographics;
