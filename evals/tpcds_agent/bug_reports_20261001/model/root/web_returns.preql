# Datasource ingested from web_returns
# Grain: item_sk, order_number. Properties: return_quantity, return_amt, return_tax, return_amt_inc_tax, fee, return_ship_cost, refunded_cash, reversed_charge, account_credit, net_loss.
# Imports: date_dim via wr_returned_date_sk (fields as date_dim.*), item via wr_item_sk (fields as item.*), reason via wr_reason_sk (fields as reason.*), refunded_addr via wr_refunded_addr_sk (fields as refunded_addr.*), refunded_cdemo via wr_refunded_cdemo_sk (fields as refunded_cdemo.*), refunded_customer via wr_refunded_customer_sk (fields as refunded_customer.*), refunded_hdemo via wr_refunded_hdemo_sk (fields as refunded_hdemo.*), returning_addr via wr_returning_addr_sk (fields as returning_addr.*), returning_cdemo via wr_returning_cdemo_sk (fields as returning_cdemo.*), returning_customer via wr_returning_customer_sk (fields as returning_customer.*), returning_hdemo via wr_returning_hdemo_sk (fields as returning_hdemo.*), time_dim via wr_returned_time_sk (fields as time_dim.*), web_page via wr_web_page_sk (fields as web_page.*).
import customer as refunded_customer;
import customer as returning_customer;
import customer_address as refunded_addr;
import customer_address as returning_addr;
import customer_demographics as refunded_cdemo;
import customer_demographics as returning_cdemo;
import date_dim as date_dim;
import household_demographics as refunded_hdemo;
import household_demographics as returning_hdemo;
import item as item;
import reason as reason;
import time_dim as time_dim;
import web_page as web_page;

key order_number bigint;

properties <order_number, item.item_sk> (
    return_quantity bigint[1..100]?,
    return_amt numeric[0..]?,
    return_tax numeric[0..]?,
    return_amt_inc_tax numeric[0..]?,
    fee numeric[0..]?,
    return_ship_cost numeric[0..]?,
    refunded_cash numeric[0..]?,
    reversed_charge numeric[0..]?,
    account_credit numeric[0..]?,
    net_loss numeric[0..]?,
);

root datasource web_returns (
    wr_returned_date_sk: ~?date_dim.date_sk,
    wr_returned_time_sk: ~?time_dim.time_sk,
    wr_item_sk: ~item.item_sk,
    wr_refunded_customer_sk: ~?refunded_customer.customer_sk,
    wr_refunded_cdemo_sk: ~?refunded_cdemo.demo_sk,
    wr_refunded_hdemo_sk: ?refunded_hdemo.demo_sk,
    wr_refunded_addr_sk: ~?refunded_addr.address_sk,
    wr_returning_customer_sk: ~?returning_customer.customer_sk,
    wr_returning_cdemo_sk: ~?returning_cdemo.demo_sk,
    wr_returning_hdemo_sk: ?returning_hdemo.demo_sk,
    wr_returning_addr_sk: ~?returning_addr.address_sk,
    wr_web_page_sk: ?web_page.web_page_sk,
    wr_reason_sk: ?reason.sk,
    wr_order_number: order_number,
    wr_return_quantity: ?return_quantity,
    wr_return_amt: ?return_amt,
    wr_return_tax: ?return_tax,
    wr_return_amt_inc_tax: ?return_amt_inc_tax,
    wr_fee: ?fee,
    wr_return_ship_cost: ?return_ship_cost,
    wr_refunded_cash: ?refunded_cash,
    wr_reversed_charge: ?reversed_charge,
    wr_account_credit: ?account_credit,
    wr_net_loss: ?net_loss,
)
grain (item.item_sk, order_number)
address web_returns;
