# Datasource ingested from store_sales
# Grain: item_sk, ticket_number. Properties: quantity, wholesale_cost, list_price, sales_price, ext_discount_amt, ext_sales_price, ext_wholesale_cost, ext_list_price, ext_tax, coupon_amt, net_paid, net_paid_inc_tax, +1 more.
# Imports: customer via ss_customer_sk (fields as customer.*), customer_address via ss_addr_sk (fields as customer_address.*), customer_demographics via ss_cdemo_sk (fields as customer_demographics.*), date_dim via ss_sold_date_sk (fields as date_dim.*), household_demographics via ss_hdemo_sk (fields as household_demographics.*), item via ss_item_sk (fields as item.*), promotion via ss_promo_sk (fields as promotion.*), store via ss_store_sk (fields as store.*), time_dim via ss_sold_time_sk (fields as time_dim.*).
import customer as customer;
import customer_address as customer_address;
import customer_demographics as customer_demographics;
import date_dim as date_dim;
import household_demographics as household_demographics;
import item as item;
import promotion as promotion;
import store as store;
import time_dim as time_dim;

key ticket_number bigint;

properties <ticket_number, item.item_sk> (
    quantity bigint[1..100]?,
    wholesale_cost numeric[0..]?,
    list_price numeric[0..]?,
    sales_price numeric[0..]?,
    ext_discount_amt numeric[0..]?,
    ext_sales_price numeric[0..]?,
    ext_wholesale_cost numeric[0..]?,
    ext_list_price numeric[0..]?,
    ext_tax numeric[0..]?,
    coupon_amt numeric[0..]?,
    net_paid numeric[0..]?,
    net_paid_inc_tax numeric[0..]?,
    net_profit numeric?,
);

root datasource store_sales (
    ss_sold_date_sk: ~?date_dim.date_sk,
    ss_sold_time_sk: ~?time_dim.time_sk,
    ss_item_sk: item.item_sk,
    ss_customer_sk: ~?customer.customer_sk,
    ss_cdemo_sk: ~?customer_demographics.demo_sk,
    ss_hdemo_sk: ?household_demographics.demo_sk,
    ss_addr_sk: ~?customer_address.address_sk,
    ss_store_sk: ~?store.store_sk,
    ss_promo_sk: ?promotion.promo_sk,
    ss_ticket_number: ticket_number,
    ss_quantity: ?quantity,
    ss_wholesale_cost: ?wholesale_cost,
    ss_list_price: ?list_price,
    ss_sales_price: ?sales_price,
    ss_ext_discount_amt: ?ext_discount_amt,
    ss_ext_sales_price: ?ext_sales_price,
    ss_ext_wholesale_cost: ?ext_wholesale_cost,
    ss_ext_list_price: ?ext_list_price,
    ss_ext_tax: ?ext_tax,
    ss_coupon_amt: ?coupon_amt,
    ss_net_paid: ?net_paid,
    ss_net_paid_inc_tax: ?net_paid_inc_tax,
    ss_net_profit: ?net_profit,
)
grain (item.item_sk, ticket_number)
address store_sales;
