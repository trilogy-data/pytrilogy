import all_sales as a;

with s as
where a.sale_date.date between '2000-08-23'::date and '2000-09-06'::date
    and a.channel_dim_id is not null
select
    a.channel as channel,
    a.channel_dim_text_id as entity,
    sum(a.ext_sales_price) as ext_sales,
    sum(a.net_profit) as sale_profit;

with r as
where a.return_date.date between '2000-08-23'::date and '2000-09-06'::date
    and a.return_channel_dim_id is not null
select
    a.channel as channel,
    a.return_channel_dim_text_id as entity,
    sum(a.return_amount) as returns,
    sum(a.return_net_loss) as return_loss;

select
    case coalesce(s.channel, r.channel)
        when 'STORE' then 'store channel'
        when 'CATALOG' then 'catalog channel'
        else 'web channel'
    end as channel,
    concat(
        case coalesce(s.channel, r.channel)
            when 'STORE' then 'store'
            when 'CATALOG' then 'catalog_page'
            else 'web_site'
        end,
        coalesce(s.entity, r.entity)
    ) as entity,
    sum(coalesce(s.ext_sales, 0)) as ext_sales,
    sum(coalesce(r.returns, 0)) as returns,
    sum(coalesce(s.sale_profit, 0)) - sum(coalesce(r.return_loss, 0)) as net_profit
union join s.channel = r.channel
union join s.entity = r.entity
by rollup (channel)
order by channel asc nulls first, entity asc nulls first
limit 100;
