# Datasource ingested from Policy_Amount
key policy_amount_identifier bigint;

properties policy_amount_identifier (
    geographic_location_identifier string?,
    policy_identifier enum<bigint>[1, 2],
    effective_date date,
    amount_type_code enum<string>['Year']?,
    earning_begin_date string?,
    earning_end_date string?,
    policy_coverage_detail_identifier enum<bigint>[1, 2, 3, 4, 5, 6],
    policy_amount double[0..],
    insurable_object_identifier string?,
    insurance_type_code string?,
);

root datasource Policy_Amount (
    Policy_Amount_Identifier: policy_amount_identifier,
    Geographic_Location_Identifier: ?geographic_location_identifier,
    Policy_Identifier: policy_identifier,
    Effective_Date: effective_date,
    Amount_Type_Code: ?amount_type_code,
    Earning_Begin_Date: ?earning_begin_date,
    Earning_End_Date: ?earning_end_date,
    Policy_Coverage_Detail_Identifier: policy_coverage_detail_identifier,
    Policy_Amount: policy_amount,
    Insurable_Object_Identifier: ?insurable_object_identifier,
    Insurance_Type_Code: ?insurance_type_code,
)
grain (policy_amount_identifier)
address Policy_Amount;
