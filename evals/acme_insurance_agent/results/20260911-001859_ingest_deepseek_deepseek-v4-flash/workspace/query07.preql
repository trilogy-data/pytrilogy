import root.Policy as p;
import root.Policy_Amount as pa;
import root.Premium as prem;

# Total premium amount paid, per policy number.
# Premiums are the Policy_Amount rows whose policy_amount_identifier is in the
# Premium model's key domain.
where pa.policy_amount_identifier in prem.policy_amount_identifier
select
    p.policy_number as policy_number,
    sum(pa.policy_amount) as total_premium_paid
subset join pa.policy_identifier = p.policy_identifier
order by p.policy_number;
