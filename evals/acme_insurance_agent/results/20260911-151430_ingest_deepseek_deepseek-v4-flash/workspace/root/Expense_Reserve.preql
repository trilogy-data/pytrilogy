# Datasource ingested from Expense_Reserve
# Grain: claim_amount_identifier. Key-only table: no columns beyond its key. A row marks a Claim_Amount row; query through Claim_Amount.is_expense_reserve.
key claim_amount_identifier enum<bigint>[2, 6];

root datasource Expense_Reserve (
    Claim_Amount_Identifier: claim_amount_identifier,
)
grain (claim_amount_identifier)
address Expense_Reserve;
