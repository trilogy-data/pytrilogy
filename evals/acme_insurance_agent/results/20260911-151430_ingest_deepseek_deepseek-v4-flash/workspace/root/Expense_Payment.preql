# Datasource ingested from Expense_Payment
# Grain: claim_amount_identifier. Key-only table: no columns beyond its key. A row marks a Claim_Amount row; query through Claim_Amount.is_expense_payment.
key claim_amount_identifier enum<bigint>[4, 8];

root datasource Expense_Payment (
    Claim_Amount_Identifier: claim_amount_identifier,
)
grain (claim_amount_identifier)
address Expense_Payment;
