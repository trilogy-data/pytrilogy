# Datasource ingested from Loss_Payment
# Grain: claim_amount_identifier. Key-only table: no columns beyond its key. A row marks a Claim_Amount row; query through Claim_Amount.is_loss_payment.
key claim_amount_identifier enum<bigint>[3, 7];

root datasource Loss_Payment (
    Claim_Amount_Identifier: claim_amount_identifier,
)
grain (claim_amount_identifier)
address Loss_Payment;
