# Datasource ingested from Loss_Reserve
# Grain: claim_amount_identifier. Key-only table: no columns beyond its key. A row marks a Claim_Amount row; query through Claim_Amount.is_loss_reserve.
key claim_amount_identifier enum<bigint>[1, 5];

root datasource Loss_Reserve (
    Claim_Amount_Identifier: claim_amount_identifier,
)
grain (claim_amount_identifier)
address Loss_Reserve;
