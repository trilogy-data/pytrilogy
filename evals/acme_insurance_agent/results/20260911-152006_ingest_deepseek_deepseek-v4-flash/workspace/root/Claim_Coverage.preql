# Datasource ingested from Claim_Coverage
# Grain: claim_identifier. Properties: effective_date.
# Imports: Policy_Coverage_Detail via Policy_Coverage_Detail_Identifier (fields as Policy_Coverage_Detail.*).
import Policy_Coverage_Detail as Policy_Coverage_Detail;

key claim_identifier enum<bigint>[1, 2];
property claim_identifier.effective_date date;

root datasource Claim_Coverage (
    Claim_Identifier: claim_identifier,
    Effective_Date: effective_date,
    Policy_Coverage_Detail_Identifier: ~Policy_Coverage_Detail.policy_coverage_detail_identifier,
)
grain (claim_identifier)
address Claim_Coverage;
