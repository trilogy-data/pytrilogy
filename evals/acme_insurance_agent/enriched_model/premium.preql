# Marker table, a key only: one row per policy_amount row that is a premium.
# Nothing to select here; policy_amount.is_premium is true for the rows this table
# marks, and the policy_amount metrics are already restricted by it.

key id int; # policy amount identifier of a premium

root datasource premium (
    Policy_Amount_Identifier: id,
)
grain (id)
address Premium;
