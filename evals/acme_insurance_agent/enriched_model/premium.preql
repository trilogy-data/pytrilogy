# One row per premium charged on a policy coverage. Policy_Amount holds every
# policy-level amount and the Premium table marks which of those are premiums;
# this model is the premium subset only, so summing amount is "premiums paid".
# Group by policy.policy_number for per-policy totals and by
# policy.policy_holder_id for what each policy holder has paid.

import policy as policy; # the policy the premium was paid on
import coverage as coverage; # the coverage the premium was charged for

key id int; # policy amount identifier
properties id (
    amount float, # premium amount
    effective_date date, # date the premium took effect
    amount_type_code string?, # unused in this dataset
);

auto total_premium <- sum(amount); # total premium paid; "total premiums paid" questions select this (by policy.policy_number, policy.policy_holder_id, ...)
auto premium_count <- count(id); # number of premium records
auto average_policy_size <- total_premium / count_distinct(policy.id); # total premium divided by the number of policies carrying premiums; "average policy size" questions select this

root datasource premium (
    Policy_Amount_Identifier: id,
    Policy_Identifier: ~policy.id,
    Policy_Coverage_Detail_Identifier: ~coverage.id,
    Effective_Date: effective_date,
    Amount_Type_Code: ?amount_type_code,
    Policy_Amount: amount,
)
grain (id)
query '''
select
    Policy_Amount_Identifier,
    Policy_Identifier,
    Policy_Coverage_Detail_Identifier,
    Effective_Date,
    Amount_Type_Code,
    Policy_Amount
from Policy_Amount
where Policy_Amount_Identifier in (select Policy_Amount_Identifier from Premium)
''';
