# One row per amount booked on a claim: a payment or a reserve, for loss or
# for expense. The kind comes from four marker tables (loss_payment,
# loss_reserve, expense_payment, expense_reserve), each flagged here as
# is_<kind> and combined into amount_kind. Per-claim totals by kind and the
# claim's total loss are derived below; sum them by claim.policy.policy_number,
# claim.policy.agent_id or claim.catastrophe.name for coarser totals.

import claim as claim; # the claim the amount was booked on
import loss_payment as loss_payment; # marker: loss payments
import loss_reserve as loss_reserve; # marker: loss reserves
import expense_payment as expense_payment; # marker: expense payments
import expense_reserve as expense_reserve; # marker: expense reserves

key id int; # claim amount identifier
properties id (
    amount float, # the amount booked
    amount_type_code string?, # unused in this dataset
    event_date date?, # unused in this dataset
);

auto is_loss_payment <- id in loss_payment.id; # a Loss_Payment row marks this amount
auto is_loss_reserve <- id in loss_reserve.id; # a Loss_Reserve row marks this amount
auto is_expense_payment <- id in expense_payment.id; # an Expense_Payment row marks this amount
auto is_expense_reserve <- id in expense_reserve.id; # an Expense_Reserve row marks this amount
auto amount_kind <- case when is_loss_payment then 'loss_payment' when is_loss_reserve then 'loss_reserve' when is_expense_payment then 'expense_payment' when is_expense_reserve then 'expense_reserve' else 'other' end; # what the amount is: a loss or expense, paid or reserved

auto loss_payment_amount <- sum(amount ? is_loss_payment) by claim.id; # loss paid out on the claim
auto loss_reserve_amount <- sum(amount ? is_loss_reserve) by claim.id; # loss reserved on the claim
auto expense_payment_amount <- sum(amount ? is_expense_payment) by claim.id; # expense paid out on the claim
auto expense_reserve_amount <- sum(amount ? is_expense_reserve) by claim.id; # expense reserved on the claim
auto loss_amount <- loss_payment_amount + loss_reserve_amount; # loss on the claim: loss payment + loss reserve; already per claim, so select it next to claim.claim_number without wrapping it in sum()
auto total_loss <- loss_payment_amount + loss_reserve_amount + expense_payment_amount + expense_reserve_amount; # total loss on the claim: loss payment + loss reserve + expense payment + expense reserve; already per claim, sum() it only for coarser grains (policy, agent, catastrophe)

root datasource claim_amount (
    Claim_Amount_Identifier: id,
    Claim_Identifier: claim.id,
    Amount_Type_Code: ?amount_type_code,
    Event_Date: ?event_date,
    Claim_Amount: amount,
)
grain (id)
address Claim_Amount;
