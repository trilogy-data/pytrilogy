# Marker table, a key only: one row per claim_amount row that is a loss payment.
# Nothing to select here; claim_amount.is_loss_payment is true for the rows this table
# marks, and the claim_amount metrics are already restricted by it.

key id int; # claim amount identifier of a loss payment

root datasource loss_payment (
    Claim_Amount_Identifier: id,
)
grain (id)
address Loss_Payment;
