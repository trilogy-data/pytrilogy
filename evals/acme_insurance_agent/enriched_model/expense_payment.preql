# Marker table, a key only: one row per claim_amount row that is a expense payment.
# Nothing to select here; claim_amount.is_expense_payment is true for the rows this table
# marks, and the claim_amount metrics are already restricted by it.

key id int; # claim amount identifier of an expense payment

root datasource expense_payment (
    Claim_Amount_Identifier: id,
)
grain (id)
address Expense_Payment;
